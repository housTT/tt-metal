diff --git a/workflows/model_specs/prod/llm.yaml b/workflows/model_specs/prod/llm.yaml
index a65d88da..71e84f11 100644
--- a/workflows/model_specs/prod/llm.yaml
+++ b/workflows/model_specs/prod/llm.yaml
@@ -1282,3 +1282,54 @@ templates:
     Qwen/Qwen3.6-27B:
       reasoning_parser_name: qwen3
       tool_call_parser_name: qwen3_coder
+# -----------------------------------------------------------------------------
+# LOCAL ADDITION (not upstream): generated TTNN autoport of ornith-ai/Ornith-1.0-35B.
+# Added by the tt-metal autoport release run so the TTI release workflow evaluates
+# models/autoports/ornith_ai_ornith_1_0_35b and NOT models/tt_transformers.
+# The server is launched externally from the tt-metal checkout (no --docker-server,
+# no --local-server); vllm_args/env_vars here record the launch configuration that
+# external server actually uses.
+#   max_context           = doc/context_contract.json supported.context_length
+#   max_tokens_all_users  = measured "GPU KV cache size: 264,192 tokens" logged by
+#                           this run.s external autoport server at max_num_seqs=32
+# -----------------------------------------------------------------------------
+- weights:
+    - ornith-ai/Ornith-1.0-35B
+  version: "0.20.0"
+  tt_metal_commit: 278e0ba
+  vllm_commit: 5380fd4
+  impl: ornith_1_0_35b_autoport
+  inference_engine: VLLM
+  model_type: LLM
+  supported_modalities:
+    - text
+  device_model_specs:
+    - device: P300X2
+      max_concurrency: 32
+      max_context: 262144
+      max_tokens_all_users_override: 264192
+      default_impl: true
+      # One lm-eval attempt per request: a retry of a multi-thousand-token
+      # reasoning generation costs the better part of an hour on this device,
+      # and the default 3x exponential backoff turns one slow sample into hours.
+      eval_max_retries: 1
+      env_vars:
+        HF_MODEL: ornith-ai/Ornith-1.0-35B
+        MESH_DEVICE: "(1, 4)"
+      vllm_args:
+        max_num_batched_tokens: "262144"
+        enable_auto_tool_choice: true
+        reasoning_parser: qwen3
+        tool_call_parser: qwen3_xml
+      override_tt_config:
+        fabric_config: FABRIC_1D_RING
+        fabric_router_max_packet_bytes: 8192
+        trace_region_size: 200000000
+        l1_small_size: 24576
+        sample_on_device_mode: all
+  status: EXPERIMENTAL
+  has_builtin_warmup: true
+  metadata:
+    ornith-ai/Ornith-1.0-35B:
+      reasoning_parser_name: qwen3
+      tool_call_parser_name: qwen3_xml
