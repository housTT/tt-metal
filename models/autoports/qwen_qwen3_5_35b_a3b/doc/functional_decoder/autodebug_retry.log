    91	def chunk_gated_delta_rule_seq_adapter(
    92	    q,  # [B, T, H, K]
    93	    k,  # [B, T, H, K]
    94	    v,  # [B, T, H, V]
    95	    beta,  # [B, T, H]
    96	    g,  # [B, T, H]
    97	    chunk_size=128,
    98	    scale=None,
    99	    initial_state=None,  # [B, H, K, V] (any dtype) or None
   100	    device=None,
   101	    cached_masks=None,
   102	    valid_len=None,
   103	    qkv_head_dims=None,  # (Hq,K,H,V): flat q/k/v [B,T,Hq*K]/[B,T,H*V]
   104	    return_o_bh=False,  # True: return o as [BH,T,V], skip token-major relayout
   105	):
   106	    """Drop-in for chunk_gated_delta_rule_ttnn using `gated_delta_attn_seq`.
   107	
   108	    [B,T,H,*] in -> (o [B,T,H,V], new_state [B,H,K,V]). L2-norms q/k, converts to
   109	    [BH,T,*] float32, runs kernel, converts back. new_state is bf16 (decode dtype) unless
   110	    QWEN_GDN_FP32_STATE=1.
   111	    """
   112	    B = q.shape[0]
   113	    T = q.shape[1]
   114	    if qkv_head_dims is not None:
   115	        # FLAT q/k [B,T,Hq*K], v [B,T,H*V]: head-split in _to_bhtd; L2 norm deferred (bit-identical).
   116	        Hq, K, H, V = qkv_head_dims
   117	        _defer_l2 = True
   118	    else:
   119	        H = v.shape[2]  # Nv: beta/g/v/output/state
   120	        Hq = q.shape[2]  # q/k heads; may be < H (GQA) — norm at Hq, expand to H after via repeat_interleave
   121	        K = q.shape[3]
   122	        V = v.shape[3]
   123	        _defer_l2 = False
   124	    BH = B * H
   125	
   126	    # L2-norm q/k (kernel doesn't); deferred for flat inputs via _defer_l2.
   127	    if not _defer_l2:
   128	        q = l2_norm_ttnn(q, dim=-1)
   129	        k = l2_norm_ttnn(k, dim=-1)
   130	
   131	    # Relayout untilize/permute in L1; land kernel inputs in DRAM (CBs ~1.36MB/core clash with L1).
   132	    _L1 = ttnn.L1_MEMORY_CONFIG
   133	
   134	    def _tilize_f32(t):
   135	        # Tilize + fp32 cast in one op (main #49565), avoiding a separate typecast pass.
   136	        return ttnn.to_layout(t, ttnn.TILE_LAYOUT, dtype=ttnn.float32, memory_config=_DRAM)
   137	
   138	    def _to_bhtd(t, D, Hh, l2=False):  # [B,T,Hh,D] (or flat [B,T,Hh*D]) -> [B*Hh,T,D] float32 TILE
   139	        t = ttnn.to_layout(t, ttnn.ROW_MAJOR_LAYOUT, memory_config=_L1)  # untilize -> L1
   140	        t = ttnn.reshape(t, [B, T, Hh, D])  # head-split (no-op if already 4D)
   141	        t = ttnn.permute(t, (0, 2, 1, 3))
   142	        t = ttnn.reshape(t, [B * Hh, T, D])
   143	        if l2:
   144	            # Per-head L2 on [BH,T,D] bf16 (before the fp32 cast) — bit-identical to pre-split norm,
   145	            # so keep tilize/typecast separate here (fused f32 tilize would norm in fp32 instead).
   146	            t = ttnn.to_layout(t, ttnn.TILE_LAYOUT, memory_config=_DRAM)  # kernel input in DRAM
   147	            t = l2_norm_ttnn(t, dim=-1)
   148	            if t.dtype != ttnn.float32:
   149	                t = ttnn.typecast(t, ttnn.float32, memory_config=_DRAM)
   150	            return t
   151	        return _tilize_f32(t)  # non-normed (v): fused tilize+cast
   152	
   153	    def _to_bht(t):  # [B,T,H] -> [BH,T] float32 TILE
   154	        t = ttnn.to_layout(t, ttnn.ROW_MAJOR_LAYOUT, memory_config=_L1)  # untilize -> L1
   155	        t = ttnn.reshape(t, [B, T, H])
   156	        t = ttnn.permute(t, (0, 2, 1))
   157	        t = ttnn.reshape(t, [BH, T])
   158	        return _tilize_f32(t)  # no norm on g/beta -> fused tilize+cast is safe
   159	
   160	    q_bh = _to_bhtd(q, K, Hq, l2=_defer_l2)
   161	    k_bh = _to_bhtd(k, K, Hq, l2=_defer_l2)
   162	    v_bh = _to_bhtd(v, V, H)
   163	    if Hq != H:
   164	        # GQA: repeat_interleave q/k along BH dim (Hq -> H heads); norm+permute ran on Hq only.
   165	        rf = H // Hq
   166	        q_bh = ttnn.repeat_interleave(q_bh, rf, dim=0)
   167	        k_bh = ttnn.repeat_interleave(k_bh, rf, dim=0)
   168	    g_bh = _to_bht(g)
   169	    beta_bh = ttnn.reshape(_to_bht(beta), [BH, T, 1])
   170	
   171	    # initial_state [B,H,K,V] -> [BH,K,V]
   172	    s0 = None
   173	    if initial_state is not None:
   174	        s0 = ttnn.reshape(initial_state, [BH, K, V])
   175	
   176	    o_bh, final_state = chunk_gated_delta_rule_seq(
   177	        q_bh,
   178	        k_bh,
   179	        v_bh,
   180	        beta_bh,
   181	        g_bh,
   182	        chunk_size=chunk_size,
   183	        scale=scale,
   184	        initial_state=s0,
   185	        mesh_device=device,
   186	        cached_masks=cached_masks,
   187	        valid_len=valid_len,
   188	    )
   189	
   190	    # o [BH,T,V] -> [B,T,H,V] (L1 shuffle, DRAM output). return_o_bh skips for caller-side fusion.
   191	    if return_o_bh:
   192	        o = o_bh
   193	    else:
   194	        o = ttnn.to_layout(o_bh, ttnn.ROW_MAJOR_LAYOUT, memory_config=_L1)
   195	        o = ttnn.reshape(o, [B, H, T, V])
   196	        o = ttnn.permute(o, (0, 2, 1, 3))  # [B,T,H,V]
   197	        o = ttnn.to_layout(o, ttnn.TILE_LAYOUT, memory_config=_DRAM)
   198	
   199	    # final_state [BH,K,V] -> [B,H,K,V]. Default bf16; QWEN_GDN_FP32_STATE=1 avoids ~128x requant in long prefill.
   200	    new_state = ttnn.reshape(final_state, [B, H, K, V])
   201	    _state_dtype = ttnn.float32 if _os.environ.get("QWEN_GDN_FP32_STATE", "0") != "0" else ttnn.bfloat16
   202	    if new_state.dtype != _state_dtype:
   203	        new_state = ttnn.typecast(new_state, _state_dtype, memory_config=_DRAM)
   204	
   205	    return o, new_state
   206	
