    18	def load_attention_weights(mesh_device, state_dict, tensor_cache_path=None) -> AttentionWeights:
    19	    def load_2d(name):
    20	        return ttnn.as_tensor(
    21	            state_dict[f"{name}.weight"],
    22	            dtype=ttnn.bfloat8_b,
    23	            layout=ttnn.TILE_LAYOUT,
    24	            device=mesh_device,
    25	            memory_config=ttnn.DRAM_MEMORY_CONFIG,
    26	            cache_file_name=(tensor_cache_path / f"self_attn.{name}.weight") if tensor_cache_path else None,
    27	            preprocess=lambda t: t.T.contiguous(),  # [in, out] for ttnn.linear; cache-miss only
    28	        )
    29	
    30	    def load_norm(name):
    31	        t = state_dict[f"{name}.weight"] + 1.0
    32	        return ttnn.as_tensor(
    33	            t,
    34	            dtype=ttnn.bfloat16,
    35	            layout=ttnn.TILE_LAYOUT,
    36	            device=mesh_device,
    37	            memory_config=ttnn.DRAM_MEMORY_CONFIG,
    38	            cache_file_name=(tensor_cache_path / f"self_attn.{name}.weight_offset") if tensor_cache_path else None,
    39	        )
    40	
    41	    return AttentionWeights(
    42	        q_proj=load_2d("q_proj"),
    43	        k_proj=load_2d("k_proj"),
    44	        v_proj=load_2d("v_proj"),
    45	        o_proj=load_2d("o_proj"),
    46	        q_norm=load_norm("q_norm"),
    47	        k_norm=load_norm("k_norm"),
    48	    )

