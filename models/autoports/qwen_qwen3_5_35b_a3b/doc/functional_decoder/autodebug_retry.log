    41	
    42	def _process_prefill_chunk(hidden_states, routing_weights, weights: ExpertWeights, config, prefill_sparsity):
    43	    """One chunk: hidden [1,1,chunk,H], routing [1,1,chunk,E_local] -> [1,1,chunk,H] (pre-allreduce).
    44	
    45	    Expert-parallel: routing_weights is already this device's expert-column slice (E_local =
    46	    num_experts/tp); prefill_sparsity is all-ones over the same E_local experts."""
    47	    chunk_len = hidden_states.shape[2]
    48	    # Per-device expert count (weights + sparsity are already sharded to E_local).
    49	    num_experts = prefill_sparsity.shape[-1]
    50	    hidden_size = config.hidden_size
    51	
    52	    group_size = chunk_len // TILE_SIZE
    53	    hidden_grouped = ttnn.reshape(hidden_states, (1, group_size, TILE_SIZE, hidden_size))
    54	    # Per-tile sparsity for gate/up: compute an expert for a 32-token tile only if some token in
    55	    # the tile routes to it (max routing weight over the tile > 0). Real prefill routing is
    56	    # concentrated (~21 of 64 local experts hit per 32-tok tile), so this skips ~2/3 of the
    57	    # all-ones overcompute. nnz varies per tile -> infer (None); a static nnz would deadlock the
    58	    # sparse_matmul mcast receivers (same reason decode uses nnz=None).
    59	    routing_tiled = ttnn.reshape(routing_weights, (1, group_size, TILE_SIZE, num_experts))
    60	    tile_mask = ttnn.max(routing_tiled, dim=2, keepdim=True)  # [1, group, 1, E_local]
    61	    tile_mask = ttnn.to_layout(tile_mask, ttnn.ROW_MAJOR_LAYOUT)
    62	    sparsity = ttnn.reshape(tile_mask, (1, 1, group_size, num_experts))
    63	    nnz = None
    64	
    65	    output_tile = ttnn.Tile([32, 32])
    66	    intermediate_size = weights.intermediate_size_per_device
