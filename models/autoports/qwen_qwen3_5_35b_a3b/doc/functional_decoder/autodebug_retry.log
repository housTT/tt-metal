    14	// Define the sentinel value for a page table entry that indicates a skip.
    15	constexpr uint32_t SKIP_PAGE_TABLE_ENTRY = (uint32_t)-1;
    16	
    17	// Tile height in rows (Blackhole/Wormhole tiles are 32x32).
    18	constexpr uint32_t TILE_H = 32;
    19	
    20	template <uint32_t num_heads, uint32_t block_size_t, uint32_t Wt>
    21	uint32_t virtual_seq_tile_id_to_physical_tile_id(
    22	    uint32_t seq_tile_idx, uint32_t cur_head, volatile tt_l1_ptr const uint32_t* const page_table_ptr) {
    23	    // Given some index in the sequence tiles in range [0, max_seq_len_t]
    24	    // Return the physical tile id for that tile row, or SKIP_PAGE_TABLE_ENTRY if block is skipped
    25	    constexpr uint32_t block_stride = num_heads * block_size_t * Wt;
    26	    const uint32_t head_offset = cur_head * block_size_t * Wt;
    27	
    28	    const uint32_t virtual_block = seq_tile_idx / block_size_t;
    29	    const uint32_t physical_block = page_table_ptr[virtual_block];
    30	
    31	    if (physical_block == SKIP_PAGE_TABLE_ENTRY) {
    32	        return SKIP_PAGE_TABLE_ENTRY;  // Return sentinel to indicate skip
    33	    }
    34	
    35	    const uint32_t block_row_offset = seq_tile_idx % block_size_t;
    36	    const uint32_t block_offset = block_row_offset * Wt;
    37	    return physical_block * block_stride + head_offset + block_offset;
    38	}
