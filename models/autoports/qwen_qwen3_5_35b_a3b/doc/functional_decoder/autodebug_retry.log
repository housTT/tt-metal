    14	class Qwen36GatedDeltaNet:
    15	    """Gated DeltaNet (linear attention) layer for Qwen3.5-9B.
    16	
    17	    Maintains fixed-size recurrent state [B, H, K, V] that replaces the KV cache.
    18	    Also maintains conv states [B, kernel_size-1, D] for causal conv1d history.
    19	    Supports two modes:
    20	      - "recurrent": single-token decode (T=1), O(1) memory
    21	      - "chunk": multi-token prefill (T>1), chunked parallel processing
    22	    """
    23	
    24	    def __init__(self, mesh_device, config: GDNConfig, state_dict, tensor_cache_path=None):
    25	        self.device = mesh_device
    26	        self.cfg = config
    27	
    28	        # Mirror config-derived scalar dims so the forward bodies read them directly.
    29	        self.num_heads = config.num_heads
    30	        self.num_v_heads = config.num_v_heads
    31	        self.head_k_dim = config.head_k_dim
    32	        self.head_v_dim = config.head_v_dim
    33	        self.conv_kernel_size = config.conv_kernel_size
    34	        self.norm_eps = config.norm_eps
    35	        self.long_prefill_chunk_size = config.long_prefill_chunk_size
    36	
    37	        self.compute_kernel_config = ttnn.WormholeComputeKernelConfig(
    38	            math_fidelity=ttnn.MathFidelity.LoFi,
    39	            fp32_dest_acc_en=True,
    40	            packer_l1_acc=False,
    41	        )
    42	        self.compute_kernel_config_decode = ttnn.WormholeComputeKernelConfig(
    43	            math_fidelity=ttnn.MathFidelity.LoFi,
    44	            fp32_dest_acc_en=True,
    45	            packer_l1_acc=True,
    46	        )
    47	
    48	        self.weights = load_gdn_weights(mesh_device, config, state_dict, tensor_cache_path)
    49	
    50	        # Persistent B=1 state, updated in place so trace-baked addresses stay valid.
    51	        def zeros(shape):
    52	            return ttnn.zeros(
    53	                shape,
    54	                dtype=ttnn.bfloat16,
    55	                layout=ttnn.TILE_LAYOUT,
    56	                device=mesh_device,
    57	                memory_config=ttnn.DRAM_MEMORY_CONFIG,
    58	            )
    59	
    60	        rec_shape = [1, self.num_v_heads, self.head_k_dim, self.head_v_dim]
    61	        conv_shape = [1, self.conv_kernel_size - 1, config.q_dim + config.k_dim + config.v_dim]
    62	        self.recurrent_state = zeros(rec_shape)
    63	        self.fused_conv_state = zeros(conv_shape)
    64	        self._zero_recurrent = zeros(rec_shape)
    65	        self._zero_conv = zeros(conv_shape)
    66	
    67	    def forward(self, x, mode="recurrent", chunk_size=None, valid_len=None):
    68	        return recurrent_forward(self, x, mode=mode, chunk_size=chunk_size, valid_len=valid_len)
    69	
    70	    def reset_state_inplace(self):
    71	        """Zero the state in place for a new sequence."""
    72	        ttnn.copy(self._zero_recurrent, self.recurrent_state)
    73	        ttnn.copy(self._zero_conv, self.fused_conv_state)
