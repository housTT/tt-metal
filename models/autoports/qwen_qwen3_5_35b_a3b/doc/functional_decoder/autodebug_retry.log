     4	"""Remap HuggingFace Qwen3.5-9B state dict to internal format.
     5	
     6	Handles:
     7	- Stripping 'model.language_model.' prefix
     8	- Filtering out vision encoder weights (MTP weights are KEPT — the spec-decode drafter)
     9	- Renaming combined in_proj_qkv → qkv_proj (DeltaNet layers; the op uses the fused weight)
    10	- Splitting combined conv1d.weight into separate Q, K, V conv weights (DeltaNet layers)
    11	- Renaming lm_head.weight → output.weight
    12	- Renaming embed_tokens → tok_embeddings
    13	"""
    14	
    15	import json
    16	from pathlib import Path
    17	from typing import Dict
    18	
    19	import torch
    20	
    21	# Layer indices that use full (softmax) attention
    22	FULL_ATTENTION_LAYERS = {3, 7, 11, 15, 19, 23, 27, 31}
    23	
    24	# DeltaNet QKV split dimensions (used to split the combined conv1d.weight into
    25	# per-stream Q/K/V conv weights — the QKV projection itself stays combined).
    26	# Q: num_key_heads(16) × key_head_dim(128) = 2048
    27	# K: num_key_heads(16) × key_head_dim(128) = 2048
    28	# (V = num_value_heads(32) × value_head_dim(128) = 4096 is the remaining slice)
    29	LINEAR_Q_DIM = 2048
    30	LINEAR_K_DIM = 2048
    31	
    32	
    33	def remap_qwen36_state_dict(state_dict: Dict[str, torch.Tensor]) -> Dict[str, torch.Tensor]:
    34	    """Remap HF Qwen3.5-9B state dict to internal format.
    35	
    36	    Args:
    37	        state_dict: Raw HuggingFace state dict loaded from safetensors.
    38	
    39	    Returns:
    40	        Remapped state dict with internal naming convention.
    41	    """
    42	    remapped = {}
    43	
    44	    for key, tensor in state_dict.items():
    45	        # Filter out vision encoder weights (check original key — no prefix stripping yet)
    46	        if "visual" in key or key.startswith("model.visual"):
    47	            continue
    48	        # NOTE: mtp.* (multi-token prediction head) weights are NOT filtered — they are the
    49	        # speculative-decode drafter. They have no model./language_model. prefix and do not
    50	        # start with "layers." so they fall through to the catch-all pass-through below
    51	        # unchanged (the DeltaNet special-casing is guarded by "layers."). See load_mtp_tensors:
    52	        # AutoModelForCausalLM (BF16 path) drops mtp.* before we see them, so load_state_dict
    53	        # reads them directly from safetensors and merges them into this dict.
    54	
    55	        # Strip the language-model prefix. Two checkpoint sources produce different
    56	        # prefixes for the same internal weights:
    57	        #   - raw sharded safetensors:           model.language_model.X
    58	        #   - AutoModelForCausalLM.from_pretrained (text-only Qwen3_5ForCausalLM): model.X
    59	        # Strip whichever matches, longest first, so BOTH sources yield identical
    60	        # internal keys. Top-level weights like lm_head.weight have no prefix and are
    61	        # matched against the original `key` below.
    62	        new_key = key
    63	        for prefix in ("model.language_model.", "model."):
    64	            if new_key.startswith(prefix):
    65	                new_key = new_key[len(prefix) :]
    66	                break
    67	
    68	        # Rename top-level weights
    69	        if new_key == "embed_tokens.weight":
    70	            remapped["tok_embeddings.weight"] = tensor
    71	            continue
    72	        if key == "lm_head.weight":
    73	            remapped["output.weight"] = tensor
    74	            continue
    75	        # Final norm (model.language_model.norm.weight)
    76	        if new_key == "norm.weight":
    77	            remapped["norm.weight"] = tensor
    78	            continue
    79	
    80	        # Handle per-layer weights
    81	        if new_key.startswith("layers."):
    82	            parts = new_key.split(".")
    83	            layer_idx = int(parts[1])
    84	            layer_prefix = f"layers.{layer_idx}"
    85	            sub_key = ".".join(parts[2:])
    86	
    87	            # DeltaNet layers: keep ONLY the combined QKV weight. The split q/k/v_proj
    88	            # were dead — the op runs the fused QKV projection from the combined weight
    89	            # (it only read the splits in a fallback reached when qkv_proj_weight is None,
    90	            # which never happens for the 9B).
    91	            if sub_key == "linear_attn.in_proj_qkv.weight":
    92	                remapped[f"{layer_prefix}.linear_attn.qkv_proj.weight"] = tensor  # [8192, 4096]
    93	                continue
    94	
    95	            if sub_key == "linear_attn.conv1d.weight":
    96	                conv = tensor  # [8192, 1, 4]
    97	                q_conv = conv[:LINEAR_Q_DIM, :, :]
    98	                k_conv = conv[LINEAR_Q_DIM : LINEAR_Q_DIM + LINEAR_K_DIM, :, :]
    99	                v_conv = conv[LINEAR_Q_DIM + LINEAR_K_DIM :, :, :]
   100	                remapped[f"{layer_prefix}.linear_attn.q_conv.weight"] = q_conv
   101	                remapped[f"{layer_prefix}.linear_attn.k_conv.weight"] = k_conv
   102	                remapped[f"{layer_prefix}.linear_attn.v_conv.weight"] = v_conv
   103	                continue
   104	
   105	            # MoE layers (Qwen3.5-MoE) pass their mlp.* keys through unchanged, to be
   106	            # consumed by tt/moe (load_expert_weights / router / shared expert):
   107	            #   mlp.gate.weight                         router      [E, H]
   108	            #   mlp.experts.gate_up_proj                fused       [E, 2I, H]
   109	            #   mlp.experts.down_proj                   fused       [E, H, I]
   110	            #   mlp.shared_expert.{gate,up,down}_proj.weight        (singular)
   111	            #   mlp.shared_expert_gate.weight           sigmoid gate [1, H]
   112	            # Normalize the DeepSeek-style plural spelling to the singular one the
   113	            # shared-expert loader expects (no-op on Qwen3.5-MoE, which is singular).
   114	            if sub_key.startswith("mlp.shared_experts."):
   115	                sub_key = sub_key.replace("mlp.shared_experts.", "mlp.shared_expert.", 1)
   116	                remapped[f"{layer_prefix}.{sub_key}"] = tensor
   117	                continue
   118	
   119	            # All other keys pass through unchanged
   120	            remapped[new_key] = tensor
   121	            continue
   122	
   123	        # Any remaining keys pass through
   124	        remapped[new_key] = tensor
   125	
   126	    return remapped
