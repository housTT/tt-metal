    93	
    94	    # up/gate fused into ONE sparse_matmul over concatenated weights (N = 2*full_intermediate),
    95	    # widening the N-gridded core count (8 -> 32) vs the old intermediate-parallel layout; the
    96	    # fused output feeds ttnn.swiglu directly as [up | gate].
    97	    gate_up_config = _build_sparse_matmul_config(batch_size, 2 * intermediate_size)
    98	    down_config = _build_sparse_matmul_config(batch_size, config.hidden_size)
    99	
   100	    up_gate = ttnn.sparse_matmul(
   101	        hidden_states,
   102	        weights.gate_up_proj,
   103	        sparsity=sparsity,
   104	        nnz=nnz,
   105	        memory_config=ttnn.L1_MEMORY_CONFIG,
   106	        output_tile=output_tile,
   107	        program_config=gate_up_config,
   108	        dtype=ttnn.bfloat16,
   109	    )
   110	    sm2 = up_gate.shape[-1]  # 2 * intermediate
   111	    # sparse_matmul returns rank 6 here: a dense [1,1,B,H] in0 contributes 2 batch dims and the
   112	    # sparse [1,E,H,2I] weights another 2, so the result is [1,1,1,E,B,2I] — expert-major, with
   113	    # the B users on dim -2. Reshaping straight to (B,E,1,sm2) would reinterpret that as
   114	    # user-major and hand each expert's down_proj another user's activation (B=1 is unaffected,
   115	    # which is why the gpt_oss decode this path follows can reshape directly: it rejects B>1).
   116	    up_gate = ttnn.reshape(up_gate, (1, num_experts, batch_size, sm2))
   117	    up_gate = ttnn.permute(up_gate, (2, 0, 1, 3))  # (batch, 1, num_experts, sm2) — keep 4D for ttnn.swiglu
   118	
   119	    down_input = apply_swiglu(up_gate)  # 4D swiglu over [up|gate] -> (batch, 1, num_experts, intermediate)
   120	    up_gate.deallocate(True)
   121	    down_input = ttnn.reshape(down_input, (batch_size, num_experts, intermediate_size))
   122	
   123	    down_input = ttnn.transpose(down_input, 1, 0)
   124	    down_input = ttnn.reshape(down_input, (1, num_experts, batch_size, intermediate_size))
   125	
   126	    down = ttnn.sparse_matmul(
   127	        down_input,
   128	        weights.down_proj,
   129	        sparsity=sparsity,
   130	        nnz=nnz,
   131	        memory_config=ttnn.L1_MEMORY_CONFIG,
   132	        output_tile=output_tile,
   133	        program_config=down_config,
   134	        is_input_a_sparse=True,
   135	        dtype=ttnn.bfloat16,
   136	    )
   137	
   138	    # down: [1, E, S, H] -> [1, S, E, H]
   139	    next_states = ttnn.permute(down, (0, 2, 1, 3))
   140	    next_states = ttnn.reshape(next_states, (batch_size, num_experts, config.hidden_size))
   141	
   142	    # weight each expert's output by its routing score, then sum over experts
   143	    routing_3d = ttnn.reshape(routing_weights, (batch_size, num_experts, 1))
   144	    next_states = ttnn.mul(next_states, routing_3d)
   145	    next_states = ttnn.sum(next_states, dim=1)
   146	    next_states = ttnn.unsqueeze_to_4D(next_states)
   147	    next_states = ttnn.reshape(
   148	        next_states,
   149	        (1, 1, batch_size, config.hidden_size),
   150	        (1, 1, max(32, batch_size), config.hidden_size),
   151	    )
   152	
   153	    # Row-parallel down_proj partials -> reduce-scatter (fractured along hidden dim=3),
   154	    # matching Qwen36MLP._forward_tp so residual/DistributedNorm alignment holds.
   155	    if num_devices > 1:
   156	        next_states = tt_all_reduce(
   157	            next_states,
   158	            mesh_device,
   159	            tt_ccl,
   160	            cluster_axis=0,
   161	            dim=3,
   162	            topology=topology,
   163	            memory_config=ttnn.DRAM_MEMORY_CONFIG,
   164	        )
   165	
   166	    return next_states

