    15	static void validate_tensor(const Tensor& t, const std::string& name) {
    16	    TT_FATAL(t.storage_type() == StorageType::DEVICE, "{} must be on device", name);
    17	    TT_FATAL(t.buffer() != nullptr, "{} must be allocated", name);
    18	    TT_FATAL(t.buffer()->buffer_type() == BufferType::DRAM, "{} must be in DRAM", name);
    19	    TT_FATAL(t.layout() == Layout::TILE, "{} must be tiled", name);
    20	    TT_FATAL(t.dtype() == DataType::FLOAT32, "{} must be float32, got {}", name, t.dtype());
    21	}
