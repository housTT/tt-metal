    23	void GatedDeltaAttnSeqDeviceOperation::validate_on_program_cache_miss(
    24	    const operation_attributes_t& attrs, const tensor_args_t& in) {
    25	    validate_tensor(in.L_unit, "L_unit");
    26	    validate_tensor(in.v_beta_sc, "v_beta_sc");
    27	    validate_tensor(in.k_bd_sc, "k_bd_sc");
    28	    validate_tensor(in.intra_attn, "intra_attn");
    29	    validate_tensor(in.q_decay, "q_decay");
    30	    validate_tensor(in.k_decay_t, "k_decay_t");
    31	    validate_tensor(in.dl_exp, "dl_exp");
    32	    validate_tensor(in.L_inv, "L_inv");
    33	    if (in.initial_state.has_value()) {
    34	        validate_tensor(*in.initial_state, "initial_state");
    35	    }
    36	
    37	    const uint32_t BH = attrs.num_heads;
    38	    const uint32_t NC = attrs.num_chunks;
    39	    const uint32_t C = attrs.chunk_size;
    40	    const uint32_t Dk = attrs.key_dim;
    41	    const uint32_t Dv = attrs.val_dim;
    42	
    43	    // The device kernels are hardwired to exactly four 32-wide block rows (Ct == Kt == Vt == 4):
    44	    // the compute kernel calls fwd_sub_4rows unconditionally and the reader always fetches the 4
    45	    // L_inv diagonal blocks. Anything other than 128 reads past L_inv or stalls the compute pipeline
    46	    // waiting on tiles that are never produced, so reject it here until the kernels are generalized.
    47	    constexpr uint32_t kRequiredDim = 4 * tt::constants::TILE_HEIGHT;  // 128
    48	    TT_FATAL(C == kRequiredDim, "chunk_size must be exactly {}, got {}", kRequiredDim, C);
    49	    TT_FATAL(Dk == kRequiredDim, "key_dim must be exactly {}, got {}", kRequiredDim, Dk);
    50	    TT_FATAL(Dv == kRequiredDim, "val_dim must be exactly {}, got {}", kRequiredDim, Dv);
    51	
    52	    auto check_shape = [&](const Tensor& t, std::initializer_list<uint32_t> expected, const std::string& nm) {
    53	        auto s = t.logical_shape();
    54	        TT_FATAL(s.rank() == expected.size(), "{} rank mismatch: {} vs {}", nm, s.rank(), expected.size());
    55	        size_t i = 0;
    56	        for (auto e : expected) {
    57	            TT_FATAL(static_cast<uint32_t>(s[i]) == e, "{} dim[{}] expected {} got {}", nm, i, e, s[i]);
    58	            i++;
    59	        }
    60	    };
    61	
    62	    check_shape(in.L_unit, {BH, NC, C, C}, "L_unit");
    63	    check_shape(in.v_beta_sc, {BH, NC, C, Dv}, "v_beta_sc");
    64	    check_shape(in.k_bd_sc, {BH, NC, C, Dk}, "k_bd_sc");
    65	    check_shape(in.intra_attn, {BH, NC, C, C}, "intra_attn");
    66	    check_shape(in.q_decay, {BH, NC, C, Dk}, "q_decay");
    67	    check_shape(in.k_decay_t, {BH, NC, Dk, C}, "k_decay_t");
    68	    check_shape(in.dl_exp, {BH, NC, 1, 1}, "dl_exp");
    69	    // L_inv: [BH, NC, C, 32] — 4 diagonal block inverses per chunk (Ct=C/32 tiles × 32 columns)
    70	    check_shape(in.L_inv, {BH, NC, C, tt::constants::TILE_HEIGHT}, "L_inv");
    71	    if (in.initial_state.has_value()) {
    72	        check_shape(*in.initial_state, {BH, Dk, Dv}, "initial_state");
    73	    }
    74	}
