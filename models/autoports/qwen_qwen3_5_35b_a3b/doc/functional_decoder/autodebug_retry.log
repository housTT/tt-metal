   300	            shape=(tpc.TILE_SIZE, self.head_dim),
   301	            core_grid=ttnn.CoreGrid(x=_cols, y=_rows),
   302	            strategy=ttnn.ShardStrategy.HEIGHT,
   303	            orientation=ttnn.ShardOrientation.ROW_MAJOR,
   304	            use_height_and_width_as_shard_shape=True,
   305	        )
