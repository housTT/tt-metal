   129	def is_fp8_checkpoint(model_path) -> bool:
   130	    """True when the checkpoint dir holds block-wise FP8 safetensors.
   131	
   132	    Detected by a ``*.weight_scale_inv`` entry in the safetensors index (the
   133	    per-block dequant scales that accompany float8_e4m3fn weights). Such a
   134	    checkpoint cannot be loaded via AutoModelForCausalLM here; use
   135	    ``load_qwen36_state_dict_fp8`` instead.
   136	    """
   137	    index_path = Path(model_path) / "model.safetensors.index.json"
   138	    if not index_path.is_file():
   139	        return False
   140	    try:
   141	        with open(index_path) as f:
   142	            weight_map = json.load(f)["weight_map"]
   143	    except (KeyError, ValueError, OSError):
   144	        return False
   145	    return any(k.endswith(".weight_scale_inv") for k in weight_map)
