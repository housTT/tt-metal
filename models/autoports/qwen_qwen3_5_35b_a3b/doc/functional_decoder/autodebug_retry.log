   208	def create_chunk_masks_seq(chunk_size, device):
   209	    """Pre-create float32 masks for seq kernel `cached_masks`.
   210	
   211	    Keys: triu_ones, tril_mask, eye, lower_causal, eye_32.
   212	    Use from_torch (not ttnn.tril/triu): at C=128 those ops produce wrong diagonals
   213	    (zeros on D_diag -> inf). Pre-allocate at init for trace safety.
   214	    """
   215	
   216	    # Replicate on TP mesh; single device leaves mapper unset (matches kernel fallback).
   217	    _mesh_mapper = ttnn.ReplicateTensorToMesh(device) if device.get_num_devices() > 1 else None
   218	
   219	    def _from(m):
   220	        return ttnn.from_torch(
   221	            m.to(torch.float32).reshape(1, m.shape[-2], m.shape[-1]),
   222	            dtype=ttnn.float32,
   223	            layout=ttnn.TILE_LAYOUT,
   224	            device=device,
   225	            mesh_mapper=_mesh_mapper,
   226	            memory_config=ttnn.DRAM_MEMORY_CONFIG,
   227	        )
   228	
   229	    ones = torch.ones(chunk_size, chunk_size)
   230	    return {
   231	        "triu_ones": _from(torch.triu(ones, diagonal=0)),
   232	        "tril_mask": _from(torch.tril(ones, diagonal=0)),
   233	        "lower_causal": _from(torch.tril(ones, diagonal=0)),
   234	        "eye": _from(torch.eye(chunk_size)),
   235	        "eye_32": _from(torch.eye(32)),
   236	    }
   237	
   238	
   239	def _solve_lower_triangular_ttnn(L, eye_1cc, mesh_device):
   240	    """Batch L^{-1} for lower triangular L = D(I+N), N strictly lower, N^C=0.
   241	
   242	    DEFAULT: Horner Neumann R = I + (-N)R (forward-substitution; stable for large ||N||).
   243	    LEGACY (QWEN_GDN_INV_DOUBLING=1): Neumann doubling + Newton-Schulz — stable only with
   244	    caller's damped L_mat (small ||N||); unstable on undamped form (||N||~19 -> fp32 overflow).
   245	
   246	    Args: L [batch,C,C], eye_1cc [1,C,C]. Returns L_inv [batch,C,C].
   247	    """
   248	    _hifi_cfg = ttnn.WormholeComputeKernelConfig(
   249	        math_fidelity=ttnn.MathFidelity.HiFi4,
   250	        math_approx_mode=False,
   251	        fp32_dest_acc_en=True,
   252	        packer_l1_acc=False,
   253	    )
   254	    mc = ttnn.L1_MEMORY_CONFIG
   255	
   256	    C = L.shape[1]
   257	    batch = L.shape[0]
   258	
   259	    D_mat = ttnn.multiply(L, eye_1cc, memory_config=mc)  # [batch, C, C]
   260	    # keepdim -> D_inv_row is [batch, C, 1] straight from the reduce (no reshape+clone; the
   261	    # [batch,C]->[batch,C,1] reshape is a TILE relayout). Col form still needs one reshape.
   262	    D_diag = ttnn.sum(D_mat, dim=-1, keepdim=True, memory_config=mc)  # [batch, C, 1]
   263	    D_inv_row = ttnn.reciprocal(D_diag, memory_config=mc)  # [batch, C, 1] all in (0, 1]
   264	    ttnn.deallocate(D_diag)
   265	    D_inv_col = ttnn.clone(ttnn.reshape(D_inv_row, [batch, 1, C], memory_config=mc), memory_config=mc)
   266	
   267	    # N = D^{-1} (L - D) via row scaling
   268	    L_strict = ttnn.subtract(L, D_mat, memory_config=mc)
   269	    ttnn.deallocate(D_mat)
   270	    N = ttnn.multiply(D_inv_row, L_strict, memory_config=mc)
   271	    ttnn.deallocate(L_strict)
   272	
   273	    # Block inverse (I+N)^{-1}. DEFAULT=Horner; legacy doubling behind QWEN_GDN_INV_DOUBLING=1.
   274	    # Doubling overflows fp32 when ||N||~19 (N^16 ~1e9); Horner matches FLA forward-substitution.
   275	    if _os.environ.get("QWEN_GDN_INV_DOUBLING", "0") != "0":
   276	        # LEGACY: doubling + Newton-Schulz; paired with damped L_mat under same flag.
   277	        P = ttnn.neg(N, memory_config=mc)  # P = -N
   278	        ttnn.deallocate(N)
   279	        R = ttnn.add(eye_1cc, P, memory_config=mc)  # R = I - N = f(2)
   280	        P_new = ttnn.matmul(P, P, memory_config=mc, compute_kernel_config=_hifi_cfg)  # P = N^2
   281	        ttnn.deallocate(P)
   282	        P = P_new
   283	
   284	        n_steps = _math.ceil(_math.log2(C)) if C > 1 else 0
   285	        for _ in range(n_steps - 1):
   286	            I_plus_P = ttnn.add(eye_1cc, P, memory_config=mc)
   287	            R_new = ttnn.matmul(R, I_plus_P, memory_config=mc, compute_kernel_config=_hifi_cfg)
   288	            ttnn.deallocate(I_plus_P)
   289	            ttnn.deallocate(R)
   290	            R = R_new
   291	            P_new = ttnn.matmul(P, P, memory_config=mc, compute_kernel_config=_hifi_cfg)
   292	            ttnn.deallocate(P)
   293	            P = P_new
   294	
   295	        ttnn.deallocate(P)
   296	
   297	        # L_inv = (I+N)^{-1} @ D^{-1} via column scaling
   298	        L_inv = ttnn.multiply(R, D_inv_col, memory_config=mc)
   299	        ttnn.deallocate(R)
   300	        ttnn.deallocate(D_inv_row)
   301	        ttnn.deallocate(D_inv_col)
   302	
   303	        # Newton-Schulz: X <- X(2I - LX)
   304	        for _ in range(2):
   305	            LX = ttnn.matmul(L, L_inv, memory_config=mc, compute_kernel_config=_hifi_cfg)
   306	            two_I_minus_LX = ttnn.subtract(ttnn.add(eye_1cc, eye_1cc, memory_config=mc), LX, memory_config=mc)
   307	            ttnn.deallocate(LX)
   308	            L_inv_new = ttnn.matmul(L_inv, two_I_minus_LX, memory_config=mc, compute_kernel_config=_hifi_cfg)
   309	            ttnn.deallocate(two_I_minus_LX)
   310	            ttnn.deallocate(L_inv)
   311	            L_inv = L_inv_new
   312	
   313	        return L_inv
   314	
   315	    # DEFAULT: Horner R = I + (-N)@R
   316	    neg_N = ttnn.neg(N, memory_config=mc)  # -N (strictly lower)
   317	    ttnn.deallocate(N)
   318	    # Pre-broadcast eye to [batch,C,C] when batch>1 (~-4% prefill; batch==1 unchanged).
   319	    _eye = eye_1cc
   320	    if batch > 1:
   321	        _eye = ttnn.repeat(eye_1cc, ttnn.Shape([batch, 1, 1]), memory_config=mc)
   322	    R = ttnn.add(_eye, neg_N, memory_config=mc)  # R_1 = I - N  ([batch,C,C])
   323	    for _ in range(C - 2):  # R_1 -> R_{C-1} = sum (-N)^j (exact: N^C=0)
   324	        NR = ttnn.matmul(neg_N, R, memory_config=mc, compute_kernel_config=_hifi_cfg)  # (-N) @ R
   325	        R_new = ttnn.add(_eye, NR, memory_config=mc)  # I + (-N) @ R
   326	        ttnn.deallocate(NR)
   327	        ttnn.deallocate(R)
   328	        R = R_new
   329	    ttnn.deallocate(neg_N)
   330	    if _eye is not eye_1cc:
   331	        ttnn.deallocate(_eye)
   332	
   333	    # L_inv = (I+N)^{-1} @ D^{-1} via column scaling
   334	    L_inv = ttnn.multiply(R, D_inv_col, memory_config=mc)
   335	    ttnn.deallocate(R)
   336	    ttnn.deallocate(D_inv_row)
   337	    ttnn.deallocate(D_inv_col)
   338	    return L_inv
   339	
   340	
   341	def _compute_L_inv_ttnn(L_mat_4d, BH, NC, C, mesh_device, _cmc=None, eye_32=None):
   342	    """Diagonal block inverses of L_mat via _solve_lower_triangular_ttnn.
   343	
   344	    L_mat_4d [BH,NC,C,C]; eye_32 [1,32,32]. Returns [BH,NC,C,32] (Ct=C/32 blocks as [C,32]).
   345	    """
   346	    if eye_32 is None:
   347	        # Test fallback without cached_masks — not trace-compatible.
   348	        eye_32 = ttnn.from_torch(
   349	            torch.eye(32, dtype=torch.float32).unsqueeze(0),
   350	            dtype=ttnn.float32,
   351	            layout=ttnn.TILE_LAYOUT,
   352	            device=mesh_device,
   353	            mesh_mapper=ttnn.ReplicateTensorToMesh(mesh_device),
   354	            memory_config=ttnn.DRAM_MEMORY_CONFIG,
   355	        )
   356	    Ct = C // 32
   357	    batch = BH * NC
   358	    L_flat = ttnn.reshape(L_mat_4d, [batch, C, C], memory_config=_cmc)
   359	
   360	    diagonal_blocks = []
   361	    for b in range(Ct):
   362	        row_start = b * 32
   363	        col_start = b * 32
   364	        block = ttnn.slice(
   365	            L_flat, [0, row_start, col_start], [batch, row_start + 32, col_start + 32], memory_config=_cmc
   366	        )
   367	        diagonal_blocks.append(block)  # [batch, 32, 32]
   368	
   369	    # The diagonal 32x32 blocks are independent. Batch them together so the Horner
   370	    # inverse runs once over [Ct*batch, 32, 32] instead of Ct separate 30-step solves.
   371	    stacked_blocks = ttnn.concat(diagonal_blocks, dim=0, memory_config=_cmc)
   372	    for block in diagonal_blocks:
   373	        ttnn.deallocate(block)
   374	
   375	    stacked_inv = _solve_lower_triangular_ttnn(stacked_blocks, eye_32, mesh_device)
   376	    ttnn.deallocate(stacked_blocks)
   377	
   378	    inv_blocks = []
   379	    for b in range(Ct):
   380	        block_start = b * batch
   381	        block_inv = ttnn.slice(stacked_inv, [block_start, 0, 0], [block_start + batch, 32, 32], memory_config=_cmc)
   382	        inv_blocks.append(block_inv)  # [batch, 32, 32]
   383	
   384	    # L_flat is a view of L_mat_4d — do not deallocate.
   385	    L_inv_flat = ttnn.concat(inv_blocks, dim=1, memory_config=_cmc)
   386	    for blk in inv_blocks:
   387	        ttnn.deallocate(blk)
   388	    ttnn.deallocate(stacked_inv)
   389	
   390	    # L_inv_flat is a view — do not deallocate.
   391	    L_inv_4d = ttnn.reshape(L_inv_flat, [BH, NC, C, 32], memory_config=_cmc)
   392	    return L_inv_4d
   393	
   394	
   395	def chunk_gated_delta_rule_seq(
   396	    q,  # [BH, T, K] float32 on mesh
   397	    k,  # [BH, T, K] float32 on mesh
   398	    v,  # [BH, T, V] float32 on mesh
   399	    beta,  # [BH, T, 1] float32 on mesh
   400	    g,  # [BH, T]    float32 on mesh
   401	    chunk_size=128,
   402	    scale=None,
   403	    initial_state=None,  # [BH, K, V] float32 or None
   404	    mesh_device=None,
   405	    cached_masks=None,
   406	    valid_len=None,
   407	):
   408	    """Chunked gated delta rule via C++ sequential scan (Path A).
   409	
   410	    Returns (output [BH,T,V], final_state [BH,K,V]) float32.
   411	    valid_len: zero q/k/v/beta/g past valid_len (padding); identity state updates preserve recurrent state.
   412	    """
   413	    # Preprocessing matmuls: HiFi4 (matches block-inverse fidelity).
   414	    _hifi_cfg = ttnn.WormholeComputeKernelConfig(
   415	        math_fidelity=ttnn.MathFidelity.HiFi4,
   416	        math_approx_mode=False,
   417	        fp32_dest_acc_en=True,
   418	        packer_l1_acc=False,
   419	    )
   420	
   421	    BH = q.shape[0]
   422	    T = q.shape[1]
   423	    K = q.shape[2]
   424	    V = v.shape[2]
   425	
   426	    if scale is None:
   427	        scale = K**-0.5
   428	
   429	    # Batched-bmm progcfg for the per-chunk [C,C]@[C,C] matmuls (kk, qk): fan the chunk-batch
   430	    # across the full device grid instead of the ~16-core auto-config. Same math (see _bmm_progcfg).
   431	    _bmm_cfg = _bmm_progcfg(mesh_device, chunk_size // _TILE, chunk_size // _TILE, K // _TILE)
   432	
   433	    # Right-padding mask: zero every state-affecting input past valid_len. The mask
   434	    # SHAPE is fixed by the bucket length T (only its values depend on valid_len), so a
   435	    # single program serves all real lengths. Mirrors the zeros concatenated below for
   436	    # pad_len; here it covers the [valid_len, T) region the caller padded.
   437	    # valid_len may be a scalar (one length for all BH rows) or a per-row list/tuple of length B
   438	    # (batched prefill): BH rows are ordered b*H + h, so user b owns rows [b*H, (b+1)*H).
