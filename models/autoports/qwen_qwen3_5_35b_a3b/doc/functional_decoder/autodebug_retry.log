   116	def prefill_forward(
   117	    hidden_states,
   118	    routing_weights,
   119	    weights: ExpertWeights,
   120	    config,
   121	    prefill_sparsity,
   122	    mesh_device=None,
   123	    tt_ccl=None,
   124	    num_devices=1,
   125	    topology=None,
   126	):
   127	    """hidden_states [1,1,S,H] (S multiple of 32), routing_weights [1,1,S,E]. Returns [1,1,S,H/tp]."""
   128	    seq_len = hidden_states.shape[2]
   129	    assert seq_len % TILE_SIZE == 0, f"Prefill seq_len must be multiple of {TILE_SIZE}, got {seq_len}"
   130	
   131	    # Expert-parallel: slice the replicated dense routing [1,1,S,E] into this device's
   132	    # contiguous expert columns [1,1,S,E/tp] (matching the dim=1-sharded expert weights),
   133	    # once for the whole sequence before chunking.
   134	    if num_devices > 1:
   135	        routing_weights = ttnn.mesh_partition(routing_weights, dim=3, cluster_axis=1)
   136	
   137	    if seq_len > PREFILL_CHUNK_SIZE:
   138	        hidden_chunks = ttnn.split(hidden_states, PREFILL_CHUNK_SIZE, dim=2)
   139	        routing_chunks = ttnn.split(routing_weights, PREFILL_CHUNK_SIZE, dim=2)
   140	    else:
   141	        hidden_chunks = [hidden_states]
   142	        routing_chunks = [routing_weights]
   143	
   144	    chunked = len(hidden_chunks) > 1
   145	    result_acc = None
   146	    for h_chunk, r_chunk in zip(hidden_chunks, routing_chunks):
   147	        chunk_result = _process_prefill_chunk(h_chunk, r_chunk, weights, config, prefill_sparsity)
   148	        if chunked:
   149	            # split() produced fresh per-chunk copies (not the caller's x/routing that the shared
   150	            # expert reuses on the single-chunk path), so free them as we go instead of holding
   151	            # every chunk resident for the whole loop.
   152	            h_chunk.deallocate(True)
   153	            r_chunk.deallocate(True)
   154	        if result_acc is None:
   155	            result_acc = chunk_result
   156	        else:
   157	            result_concat = ttnn.concat([result_acc, chunk_result], dim=2)
   158	            result_acc.deallocate(True)
   159	            chunk_result.deallocate(True)
   160	            result_acc = result_concat
