     3	"""On-device expert decode forward using sparse_matmul (the B decode users sit on dim-2).
     4	
     5	Mirrors the gemma4 experts decode path with two Qwen changes: SwiGLU (not GeGLU),
     6	and the row-parallel down_proj is combined with the qwen tt_all_reduce, which on the
     7	(1,4) mesh REDUCE-SCATTERS along dim=3 — leaving the output fractured along the hidden
     8	dim, exactly like Qwen36MLP._forward_tp, so the layer's residual add + DistributedNorm
     9	stay aligned. sparse_matmul output is 6D: [batch_dims..., num_experts, seq_tiles, n].
    10	"""
    11	
    12	import math
    13	
    14	import ttnn
    15	from models.tt_transformers.tt.ccl import tt_all_reduce
    16	
    17	from .operations import apply_swiglu
    18	from .weights import ExpertWeights
    19	
    20	
    21	def _build_sparse_matmul_config(m, n, in0_block_w=1):
    22	    """Program config for sparse_matmul (largest divisor of n_tiles fitting an 8x8 grid)."""
    23	    n_tiles = int(math.ceil(n / 32))
    24	
    25	    best_cores = 1
    26	    best_cx, best_cy = 1, 1
    27	    for num_cores in range(1, min(65, n_tiles + 1)):
    28	        if n_tiles % num_cores != 0:
    29	            continue
    30	        for cy in range(1, 9):
    31	            if num_cores % cy == 0:
    32	                cx = num_cores // cy
    33	                if cx <= 8 and num_cores > best_cores:
    34	                    best_cores = num_cores
    35	                    best_cx, best_cy = cx, cy
    36	                    break
    37	
    38	    per_core_N = n_tiles // best_cores
    39	
    40	    return ttnn.MatmulMultiCoreReuseMultiCast1DProgramConfig(
    41	        compute_with_storage_grid_size=ttnn.CoreCoord(best_cx, best_cy),
    42	        in0_block_w=in0_block_w,
    43	        out_subblock_h=1,
    44	        out_subblock_w=1,
    45	        out_block_h=1,
    46	        out_block_w=per_core_N,
    47	        per_core_M=max(32, m) // 32,
    48	        per_core_N=per_core_N,
    49	        fuse_batch=False,
    50	        fused_activation=None,
    51	        mcast_in0=True,
    52	    )
    53	
    54	
    55	def decode_forward(
    56	    hidden_states,
    57	    routing_weights,
    58	    weights: ExpertWeights,
    59	    config,
    60	    mesh_device=None,
    61	    tt_ccl=None,
    62	    num_devices=1,
    63	    topology=None,
    64	):
    65	    """hidden_states [1,1,S,H] (S = decode batch), routing_weights [1,1,S,E]. Returns [1,1,S,H/tp]."""
    66	    batch_size = hidden_states.shape[2]
    67	    top_k = config.top_k
    68	    intermediate_size = weights.intermediate_size_per_device
    69	    # Expert-parallel: each device owns num_experts/num_devices experts (weights sharded dim=1).
    70	    num_experts = config.num_experts // num_devices if num_devices > 1 else config.num_experts
    71	
    72	    # Slice the replicated dense routing [1,1,S,E] into THIS device's contiguous expert columns
