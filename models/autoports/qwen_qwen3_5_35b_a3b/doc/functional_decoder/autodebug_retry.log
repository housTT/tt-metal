    14	def rotate_half_ttnn(x):
    15	    """Rotates half the hidden dims of the input."""
    16	    half_dim = x.shape[-1] // 2
    17	    x1 = x[..., :half_dim]
    18	    x2 = x[..., half_dim:]
    19	    return ttnn.concat([ttnn.neg(x2), x1], dim=-1)
