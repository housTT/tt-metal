    96	        self.mtp_num_hidden_layers = getattr(text_config, "mtp_num_hidden_layers", 0)
    97	        self.mtp_use_dedicated_embeddings = getattr(text_config, "mtp_use_dedicated_embeddings", False)
    98	        if enable_mtp is None:
