   442	
   443	    // Normalize negative dimension to positive index
   444	    const auto& input_shape = input_tensor.logical_shape();
   445	    int64_t normalized_dim = input_shape.get_normalized_index(dim);
   446	
   447	    // ceil(dim_size / split_size) chunks of size split_size, with a smaller final chunk when the
   448	    // dimension is not evenly divisible. Build the size list so it sums exactly to the dimension
   449	    // (the last entry holds the remainder), which keeps the list overload's strict sum check
   450	    // satisfied. Compute the quotient and remainder separately to avoid overflowing
   451	    // dim_size + split_size for a large split_size.
   452	    const int64_t dim_size = static_cast<int64_t>(input_shape[normalized_dim]);
   453	    const int64_t num_chunks = dim_size / split_size + (dim_size % split_size != 0 ? 1 : 0);
   454	
   455	    ttsl::SmallVector<int64_t> split_sizes(num_chunks, split_size);
   456	    if (num_chunks > 0) {
   457	        split_sizes.back() = dim_size - split_size * (num_chunks - 1);
   458	    }
   459	    // Pass memory_config_arg directly so the split_sizes overload applies the
   460	    // same sharding-default logic (sharded input → DRAM output when no explicit config).
   461	    return ttnn::split(input_tensor, split_sizes, normalized_dim, memory_config_arg);
   462	}
