    51	def test_layer0_deltanet_decode(device, setup):
    52	    """Layer 0 (DeltaNet) recurrent decode — single token, continuing from a real prefill.
    53	
    54	    Mirrors the model's order of operations: prefill first (which populates the GDN recurrent +
    55	    conv state), then decode one token from that state. A cold decode with no prior prefill is not a
    56	    real scenario and compiles the full-L1 conv path (conv state absent) → L1 overflow.
    57	    """
    58	    args, sd, raw = setup
    59	    device.enable_program_cache()
    60	
    61	    layer = Qwen36DecoderLayer(device, args, sd, layer_num=0)
    62	
    63	    # Prefill to establish GDN recurrent + conv state (the state decode continues from).
    64	    x_pf = torch.randn(1, GDN_PREFILL_CHUNK, args.dim, dtype=torch.bfloat16)
    65	    x_pf_t = ttnn.from_torch(x_pf, dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=device)
    66	    layer.forward(x_pf_t, mode="prefill", chunk_size=GDN_PREFILL_CHUNK)
    67	
    68	    # Decode one token from the carried state.
    69	    x_dec = torch.randn(1, 1, args.dim, dtype=torch.bfloat16)
    70	    x_dec_t = ttnn.from_torch(x_dec, dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=device)
    71	    out = ttnn.to_torch(layer.forward(x_dec_t, mode="decode"))
    72	
    73	    assert out.shape == (1, 1, args.dim), f"Wrong shape: {out.shape}"
    74	    assert not torch.isnan(out).any(), "Output contains NaN"
    75	
