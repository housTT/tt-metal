   229	
   230	    # Precompute conv weight taps and bias on device to avoid CPU round-trips during decode
   231	    q_weight_taps = _precompute_weight_taps(q_conv_weight)
   232	    k_weight_taps = _precompute_weight_taps(k_conv_weight)
   233	    v_weight_taps = _precompute_weight_taps(v_conv_weight)
   234	    q_bias_dev = _precompute_bias_dev(q_conv_bias)
   235	    k_bias_dev = _precompute_bias_dev(k_conv_bias)
   236	    v_bias_dev = _precompute_bias_dev(v_conv_bias)
   237	
   238	    # Precompute fused QKV conv weight taps [1, 1, D_total] for fused conv decode
   239	    fused_conv_weight_taps = _precompute_fused_weight_taps()
   240	    fused_conv_bias_dev = _precompute_fused_bias_dev()
   241	
   242	    # Fused a+b projection weight: [4096, 64] — saves 1 matmul per decode step
   243	    ab_proj_weight = _precompute_fused_ab_weight()
   244	
   245	    # Mega-fused weight: QKV + a + b + g in one [4096, 12352] matmul
   246	    # Eliminates 2 separate matmuls (g_proj, ab_proj) per decode step
   247	    mega_fused_weight = _precompute_mega_fused_weight()
   248	    if mega_fused_weight is not None:
   249	        mega_qkv_dim = config.q_dim + config.k_dim + config.v_dim
   250	        mega_a_dim = num_v_heads
   251	        mega_b_dim = num_v_heads
   252	        mega_g_dim = num_v_heads * head_v_dim
   253	    else:
   254	        mega_qkv_dim = None
   255	        mega_a_dim = None
   256	        mega_b_dim = None
   257	        mega_g_dim = None
