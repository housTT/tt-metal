    75	        self.linear_num_value_heads = getattr(text_config, "linear_num_value_heads", 32)
    76	        self.linear_key_head_dim = getattr(text_config, "linear_key_head_dim", 128)
    77	        self.linear_value_head_dim = getattr(text_config, "linear_value_head_dim", 128)
