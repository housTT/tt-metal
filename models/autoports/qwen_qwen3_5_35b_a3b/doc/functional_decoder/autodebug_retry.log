   145	    def _init_tp_config(self, mesh_device):
   146	        """Per-device sharded dims + DRAM matmul/mem configs for TP (num_devices>1)."""
   147	        import ttnn
   148	        from models.demos.blackhole.qwen36.tt import tp_common as tpc
   149	
   150	        tp = self.num_devices
   151	        self.cluster_shape = list(mesh_device.shape)
   152	
   153	        # GDN dims (match qwen35_27b reference names).
   154	        self.gdn_nk = self.linear_num_key_heads
   155	        self.gdn_dk = self.linear_key_head_dim
   156	        self.gdn_nv = self.linear_num_value_heads
   157	        self.gdn_dv = self.linear_value_head_dim
   158	        self.gdn_program_config = None
   159	        self.gdn_wy_inverse = None
   160	        self.gdn_conv_kernel_size = self.linear_conv_kernel_dim
   161	        self.gdn_key_dim = self.linear_q_dim  # q and k equal
   162	        self.gdn_value_dim = self.linear_v_dim
   163	        self.gdn_qkv_dim = self.linear_q_dim + self.linear_k_dim + self.linear_v_dim
   164	        self.gdn_z_dim = self.linear_v_dim
   165	        self.gdn_chunk_size = 128  # GDN seq kernel requires 128
   166	
   167	        # Per-device (sharded) dims
   168	        assert self.n_heads % tp == 0, f"n_heads {self.n_heads} not divisible by TP={tp}"
   169	        assert self.gdn_nk % tp == 0 and self.gdn_nv % tp == 0, "GDN head counts must divide by TP"
   170	        self.n_local_heads = self.n_heads // tp
   171	        self.n_local_kv_heads = max(1, self.n_kv_heads // tp)
   172	        # 35B-A3B has 2 KV heads on 4 devices -> True (each KV head replicated across tp/n_kv_heads
   173	        # devices); dense 27B has n_kv_heads >= tp -> False (even shard).
   174	        self.kv_replication = tp > self.n_kv_heads
   175	        self.gdn_nk_tp = self.gdn_nk // tp
   176	        self.gdn_nv_tp = self.gdn_nv // tp
   177	        self.gdn_qkv_dim_tp = self.gdn_qkv_dim // tp
   178	        self.gdn_z_dim_tp = self.gdn_z_dim // tp
   179	        self.gdn_qkvz_dim_tp = (self.gdn_qkv_dim + self.gdn_z_dim) // tp
   180	        # Per-device width of the [qkv|z|a|b] fused in-projection: folding the tiny a/b (decay/beta)
   181	        # projection into qkvz removes a whole decode matmul while keeping the (good) K=dim. Default
   182	        # (was QWEN36_GDN_FUSE_AB); gdn/tp.py fuses whenever the qkvz weight is DRAM-sharded.
   183	        self.gdn_qkvzab_dim_tp = self.gdn_qkvz_dim_tp + 2 * self.gdn_nv_tp
   184	        self.gdn_value_dim_tp = self.gdn_value_dim // tp
   185	        self.gdn_key_dim_tp = self.gdn_key_dim // tp
   186	        self.attn_out_dim_tp = (self.n_heads * self.head_dim) // tp
   187	        kv_dim_per_device = self.n_local_kv_heads * self.head_dim
   188	
   189	        # DRAM-sharded weights: column-parallel [hidden, out_tp]
   190	        self.gdn_qkvz_weight_memcfg = tpc.create_dram_sharded_mem_config(self.dim, self.gdn_qkvz_dim_tp)
   191	        self.gdn_qkvzab_weight_memcfg = tpc.create_dram_sharded_mem_config(self.dim, self.gdn_qkvzab_dim_tp)
   192	        self.attn_qg_weight_memcfg = tpc.create_dram_sharded_mem_config(
   193	            self.dim, self.n_local_heads * self.head_dim * 2
   194	        )
   195	        self.attn_k_weight_memcfg = tpc.create_dram_sharded_mem_config(self.dim, kv_dim_per_device)
   196	        self.attn_v_weight_memcfg = tpc.create_dram_sharded_mem_config(self.dim, kv_dim_per_device)
   197	        # Fused [q+gate | k | v] in-projection (P4: QWEN36_FUSED_QKV) — one column-parallel matmul.
   198	        self.attn_qkv_fused_dim_tp = self.n_local_heads * self.head_dim * 2 + 2 * kv_dim_per_device
   199	        self.attn_qkv_fused_weight_memcfg = tpc.create_dram_sharded_mem_config(self.dim, self.attn_qkv_fused_dim_tp)
   200	        self.mlp_w1_weight_memcfg = tpc.create_dram_sharded_mem_config(self.dim, self.hidden_dim // tp)
