    27	def test_layer0_deltanet_prefill_block(device, setup):
    28	    """Layer 0 (DeltaNet) full decoder block, chunk-seq prefill — runs and is non-constant.
    29	
    30	    Uses the only chunk size the GDN chunk-seq kernel supports (128); chunk_size=64 is unsupported.
    31	    """
    32	    args, sd, raw = setup
    33	    device.enable_program_cache()
    34	
    35	    B, T = 1, GDN_PREFILL_CHUNK
    36	    x = torch.randn(B, T, args.dim, dtype=torch.bfloat16)
    37	
    38	    block = Qwen36DecoderLayer(device, args, sd, layer_num=0)
    39	
    40	    x_t = ttnn.from_torch(x, dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=device)
    41	    out = ttnn.to_torch(block.forward(x_t, mode="prefill", chunk_size=GDN_PREFILL_CHUNK))
    42	
    43	    logger.info(
    44	        f"block0 prefill out: shape={out.shape} range=[{out.min():.4f},{out.max():.4f}] std={out.float().std():.4f}"
    45	    )
    46	    assert out.shape == (B, T, args.dim), f"Wrong shape: {out.shape}"
    47	    assert not torch.isnan(out).any(), "Output contains NaN"
    48	    assert out.float().std() > 0.01, "Output is near-constant"
    49	
