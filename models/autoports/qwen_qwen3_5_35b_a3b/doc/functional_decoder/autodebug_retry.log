    10	
    11	
    12	class Qwen36Experts:
    13	    def __init__(self, mesh_device, config, state_dict, tensor_cache_path=None, tt_ccl=None, topology=None):
    14	        self.mesh_device = mesh_device
    15	        self.config = config
    16	        self.num_devices = config.num_devices
    17	        self.tt_ccl = tt_ccl
    18	        self.topology = topology
    19	        self.weights = load_expert_weights(mesh_device, config, state_dict, tensor_cache_path)
    20	        # Expert-parallel: each device computes only its expert shard, so the all-ones prefill
    21	        # sparsity is sized to the per-device expert count (num_experts / num_devices).
    22	        experts_per_device = config.num_experts // self.num_devices if self.num_devices > 1 else config.num_experts
    23	        self.prefill_sparsity = create_prefill_sparsity(mesh_device, experts_per_device)
