    29	def create_prefill_sparsity(mesh_device, num_experts):
    30	    """All-ones sparsity mask [1,1,1,E] (ROW_MAJOR bf16); routing zeros inactive experts later."""
    31	    is_mesh = hasattr(mesh_device, "shape")
