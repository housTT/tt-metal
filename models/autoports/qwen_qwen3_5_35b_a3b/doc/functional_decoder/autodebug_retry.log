   230	        # forced1d_*). Applied to gate/up ONLY (the swept, verified projections); the others below keep
   231	        # the legacy cols<=8 shaping (grid_w default) until their shapes are swept too.
   232	        self.decode_grid_w = mesh_device.compute_with_storage_grid_size().x
   233	        self.mlp_1d_decode = True
   234	        # gate/up: num_cores=44 -> 11x4 on BH, the fastest measured config (wide1d_11x4c, 42.8us vs
   235	        # 43.9us for the old 8x4=forced1d_32c). On WH (decode_grid_w=8) this falls back to 8x6.
   236	        self.mlp_w1_decode_1d_progcfg = tpc.create_matmul_1d_decode_progcfg(
   237	            M,
   238	            self.dim,
   239	            self.hidden_dim // tp,
   240	            num_cores=44,
   241	            fused_activation=ttnn.UnaryOpType.SILU,
   242	            grid_w=self.decode_grid_w,
   243	        )
   244	        self.mlp_w3_decode_1d_progcfg = tpc.create_matmul_1d_decode_progcfg(
   245	            M, self.dim, self.hidden_dim // tp, num_cores=44, grid_w=self.decode_grid_w
   246	        )
   247	        # down: num_cores=33 -> 11x3 on BH, the fastest measured config (wide1d_11x3c, ~63us, +28% vs
   248	        # the old 8x2). On WH (decode_grid_w=8) this falls back to 8x5.
   249	        self.mlp_w2_decode_1d_progcfg = tpc.create_matmul_1d_decode_progcfg(
   250	            M, self.hidden_dim // tp, self.dim, num_cores=33, grid_w=self.decode_grid_w
   251	        )
   252	
   253	        # Input-projection 1D decode (DEFAULT): same idea for attn QKV+gate and GDN QKVZAB in-projections.
