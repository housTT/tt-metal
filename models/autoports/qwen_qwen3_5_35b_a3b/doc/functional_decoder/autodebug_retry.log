    34	        sparsity,
    35	        layout=ttnn.ROW_MAJOR_LAYOUT,
    36	        dtype=ttnn.bfloat16,
    37	        device=mesh_device,
    38	        mesh_mapper=ttnn.ReplicateTensorToMesh(mesh_device) if is_mesh else None,
    39	    )
