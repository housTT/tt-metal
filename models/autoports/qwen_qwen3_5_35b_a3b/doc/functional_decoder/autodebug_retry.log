    74	    # dim=1-sharded expert weights. nnz is then inferred (None): the selected experts split
    75	    # unevenly across devices, so a static count would deadlock the sparse_matmul mcast
    76	    # receivers (see gpt_oss #45943/#45052).
    77	    if num_devices > 1:
    78	        routing_weights = ttnn.mesh_partition(routing_weights, dim=3, cluster_axis=1)
