     3	"""MoE router: linear -> softmax -> topk -> (sum-normalize) -> scatter.
     4	
     5	Fully on-device, trace-compatible. Returns dense routing weights [1,1,S,E] on device
     6	(weights at the selected experts, zeros elsewhere) for sparse_matmul.
     7	
     8	Simpler than gemma4's router: Qwen3-Next/Qwen3.5-MoE has NO router RMSNorm, NO input
     9	pre-scale, and NO per-expert scale. Matmul + softmax accumulate in fp32 to match HF's
    10	routing precision.
    11	"""
    12	
    13	import torch
    14	
    15	import ttnn
    16	from models.demos.blackhole.qwen36.tt import tp_common as tpc
    17	
    18	
    19	class Qwen36Router:
    20	    def __init__(self, mesh_device, config, state_dict, tensor_cache_path=None, dtype=ttnn.bfloat16):
    21	        self.num_experts = config.num_experts
    22	        self.top_k = config.top_k
    23	        self.norm_topk_prob = config.norm_topk_prob
    24	
    25	        is_mesh = hasattr(mesh_device, "shape")
    26	        replicate_mapper = ttnn.ReplicateTensorToMesh(mesh_device) if is_mesh else None
    27	
    28	        # HF mlp.gate.weight is [E, H] (nn.Linear out,in). Transpose to [1,1,H,E] for
    29	        # ttnn.linear (in,out) and replicate on every device (router is tiny +
    30	        # accuracy-sensitive, kept at bf16).
    31	        # The cast + transpose run as the as_tensor preprocess, i.e. on a tensor-cache miss only.
    32	        self.proj_weight = ttnn.as_tensor(
    33	            state_dict["weight"] if state_dict else None,
    34	            device=mesh_device,
    35	            dtype=dtype,
    36	            layout=ttnn.TILE_LAYOUT,
    37	            mesh_mapper=replicate_mapper,
    38	            cache_file_name=(str(tensor_cache_path / "moe.router.weight") if tensor_cache_path else None),
    39	            memory_config=ttnn.DRAM_MEMORY_CONFIG,
    40	            preprocess=lambda t: t.to(torch.bfloat16).transpose(-2, -1).unsqueeze(0).unsqueeze(0),
    41	        )
    42	        self.compute_kernel_config = tpc.COMPUTE_HIFI2  # fp32 accumulate (see module docstring)
    43	
    44	    def __call__(self, hidden_states):
    45	        """hidden_states: [1,1,S,H] (replicated full hidden). Returns [1,1,S,E]."""
    46	        expert_scores = ttnn.linear(hidden_states, self.proj_weight, compute_kernel_config=self.compute_kernel_config)
    47	        router_probs = ttnn.softmax(expert_scores, dim=-1)
    48	        expert_scores.deallocate(True)
    49	
    50	        top_k_values, top_k_indices = ttnn.topk(router_probs, k=self.top_k, dim=-1)
    51	
    52	        # Sum-normalize the top-k weights so they sum to 1 per token (HF norm_topk_prob).
    53	        if self.norm_topk_prob:
    54	            top_k_sum = ttnn.sum(top_k_values, dim=-1, keepdim=True)
    55	            top_k_values = ttnn.div(top_k_values, top_k_sum)
    56	            top_k_sum.deallocate(True)
    57	
    58	        dense_routing = ttnn.scatter(
    59	            ttnn.zeros_like(router_probs),
    60	            dim=-1,
    61	            index=top_k_indices,
    62	            src=top_k_values,
    63	        )
    64	        router_probs.deallocate(True)
    65	        top_k_values.deallocate(True)
    66	        top_k_indices.deallocate(True)
    67	        return dense_routing

