    27	        x = ttnn.to_torch(t).float()
    28	        print(
    29	            f"  [dbg] {name}: max|.|={x.abs().max().item():.4g} min={x.min().item():.4g} inf={bool(torch.isinf(x).any())} nan={bool(torch.isnan(x).any())}",
    30	            flush=True,
    31	        )
    32	    except Exception as e:
    33	        print(f"  [dbg] {name}: <err {e}>", flush=True)
