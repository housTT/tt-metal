     3	"""Weight loading + precompute for the Qwen3.5-9B Gated DeltaNet layer.
     4	
     5	Loads the projection / conv / norm weights for one `linear_attn` substate and
     6	precomputes the derived device tensors (conv taps, fused matmuls, prefill-kernel
     7	constants, cached chunk masks). Behavior-preserving extraction of the original
     8	`Qwen36GatedDeltaNet.__init__` weight code — every dtype / layout / memory_config
     9	and every env-var read is preserved verbatim.
    10	"""
    11	from dataclasses import dataclass
    12	
    13	import torch
    14	
    15	import ttnn
    16	from models.demos.blackhole.qwen36.tt.gdn.config import GDNConfig
    17	from models.experimental.gated_attention_gated_deltanet.tt.ttnn_delta_rule_seq import create_chunk_masks_seq
    18	
    19	
    20	@dataclass
    21	class GDNWeights:
    22	    # Projection weights
    23	    qkv_proj_weight: ttnn.Tensor
    24	    q_proj_weight: object  # None — dead split (op runs fused QKV); kept as kwarg
    25	    k_proj_weight: object
    26	    v_proj_weight: object
    27	    a_proj_weight: ttnn.Tensor
    28	    b_proj_weight: ttnn.Tensor
    29	    g_proj_weight: ttnn.Tensor
    30	    o_proj_weight: ttnn.Tensor
    31	    # Conv weights (stay on HOST, ROW_MAJOR) + biases
    32	    q_conv_weight: ttnn.Tensor
    33	    k_conv_weight: ttnn.Tensor
    34	    v_conv_weight: ttnn.Tensor
    35	    q_conv_bias: object
    36	    k_conv_bias: object
    37	    v_conv_bias: object
    38	    # 1D params
    39	    A_log: ttnn.Tensor
    40	    dt_bias: ttnn.Tensor
    41	    o_norm_weight: ttnn.Tensor
    42	    A_neg: ttnn.Tensor
    43	    # Precomputed conv taps / bias on device
    44	    q_weight_taps: list
    45	    k_weight_taps: list
    46	    v_weight_taps: list
    47	    q_bias_dev: object
    48	    k_bias_dev: object
    49	    v_bias_dev: object
    50	    fused_conv_weight_taps: list
    51	    fused_conv_bias_dev: object
    52	    # Fused projection weights
    53	    ab_proj_weight: ttnn.Tensor
    54	    mega_fused_weight: object
    55	    mega_qkv_dim: object
    56	    mega_a_dim: object
    57	    mega_b_dim: object
    58	    mega_g_dim: object
    59	    # Chunk-parallel prefill kernel (gated_delta_attn_seq) — always on
    60	    use_chunk_seq_prefill: bool
    61	    chunk_seq_masks_long: object
    62	
    63	
    64	def load_gdn_weights(mesh_device, config: GDNConfig, state_dict, tensor_cache_path=None) -> GDNWeights:
    65	    """Load + precompute all device weights for one Gated DeltaNet layer.
    66	
    67	    `state_dict` is the per-layer `linear_attn` substate (keys already stripped of
    68	    the `layers.{n}.linear_attn.` prefix). `tensor_cache_path` points at the
    69	    `layers.{n}` directory (or None) — cache file names re-add the `linear_attn.`
    70	    prefix to match the original cache keys exactly.
    71	    """
    72	    num_heads = config.num_heads
    73	    num_v_heads = config.num_v_heads
    74	    head_k_dim = config.head_k_dim
    75	    head_v_dim = config.head_v_dim
    76	    conv_kernel_size = config.conv_kernel_size
    77	    norm_eps = config.norm_eps
    78	
    79	    def load_weight_2d(name):
    80	        """Load 2D weight, transposed to [in, out] for ttnn.linear (on a tensor-cache miss only)."""
    81	        return ttnn.as_tensor(
    82	            state_dict[name],
    83	            dtype=ttnn.bfloat8_b,
    84	            layout=ttnn.TILE_LAYOUT,
    85	            device=mesh_device,
    86	            memory_config=ttnn.DRAM_MEMORY_CONFIG,
    87	            cache_file_name=(tensor_cache_path / f"linear_attn.{name}") if tensor_cache_path else None,
    88	            preprocess=lambda t: t.T.contiguous(),
    89	        )
    90	
    91	    def load_conv_weight(name):
    92	        """Load conv1d weight — stays on HOST (not device), ROW_MAJOR layout."""
    93	        t = state_dict[name]
    94	        return ttnn.from_torch(t, dtype=ttnn.bfloat16, memory_config=ttnn.L1_MEMORY_CONFIG)
    95	
    96	    def load_1d(name):
    97	        """Load 1D param — must use TILE_LAYOUT on device like all other tensors."""
    98	        t = state_dict[name]
    99	        return ttnn.as_tensor(
   100	            t,
   101	            dtype=ttnn.bfloat16,
   102	            layout=ttnn.TILE_LAYOUT,
   103	            device=mesh_device,
   104	            memory_config=ttnn.DRAM_MEMORY_CONFIG,
   105	            cache_file_name=(tensor_cache_path / f"linear_attn.{name}") if tensor_cache_path else None,
   106	        )
   107	
   108	    # Fused QKV projection: one matmul instead of three
   109	    qkv_key = "qkv_proj.weight"
   110	    if qkv_key not in state_dict:
   111	        raise ValueError(
   112	            f"DeltaNet layer requires the combined qkv_proj weight "
   113	            f"(key '{qkv_key}' missing; the split q/k/v_proj were removed in the weight refactor)."
   114	        )
   115	    qkv_proj_weight = ttnn.as_tensor(
   116	        state_dict[qkv_key],
   117	        dtype=ttnn.bfloat8_b,
   118	        layout=ttnn.TILE_LAYOUT,
   119	        device=mesh_device,
   120	        memory_config=ttnn.DRAM_MEMORY_CONFIG,
   121	        cache_file_name=(tensor_cache_path / "linear_attn.qkv_proj.weight") if tensor_cache_path else None,
   122	        preprocess=lambda t: t.T.contiguous(),  # [4096, 8192]; cache-miss only
   123	    )
   124	    # The split q/k/v_proj are dead (the op runs the fused QKV from the combined weight; it
   125	    # reads the splits only in a fallback reached when qkv_proj_weight is None). Not created,
   126	    # saving ~33MB/layer of device memory. The op still receives them as kwargs (None).
   127	    q_proj_weight = None
   128	    k_proj_weight = None
   129	    v_proj_weight = None
   130	    a_proj_weight = load_weight_2d("in_proj_a.weight")
   131	    b_proj_weight = load_weight_2d("in_proj_b.weight")
   132	    g_proj_weight = load_weight_2d("in_proj_z.weight")
   133	    o_proj_weight = load_weight_2d("out_proj.weight")
   134	
   135	    q_conv_weight = load_conv_weight("q_conv.weight")
   136	    k_conv_weight = load_conv_weight("k_conv.weight")
   137	    v_conv_weight = load_conv_weight("v_conv.weight")
   138	
   139	    def load_conv_bias_or_none(name):
   140	        if name in state_dict:
   141	            t = state_dict[name]
   142	            return ttnn.from_torch(t, dtype=ttnn.bfloat16, memory_config=ttnn.L1_MEMORY_CONFIG)
   143	        return None
   144	
   145	    q_conv_bias = load_conv_bias_or_none("q_conv.bias")
   146	    k_conv_bias = load_conv_bias_or_none("k_conv.bias")
   147	    v_conv_bias = load_conv_bias_or_none("v_conv.bias")
   148	
   149	    A_log = load_1d("A_log")
   150	    dt_bias = load_1d("dt_bias")
