   148	def load_mtp_tensors(model_path) -> Dict[str, torch.Tensor]:
   149	    """Read the MTP head tensors (mtp.*) directly from the checkpoint safetensors.
   150	
   151	    AutoModelForCausalLM (the BF16 load path) drops mtp.* via
   152	    ``_keys_to_ignore_on_load_unexpected = [r"^mtp.*"]`` BEFORE remap_qwen36_state_dict ever
   153	    sees them, so the spec-decode drafter weights must be read straight from the safetensors.
   154	    Returns the 15 mtp.* tensors keyed verbatim (mtp.fc.weight, mtp.pre_fc_norm_embedding.weight,
   155	    mtp.pre_fc_norm_hidden.weight, mtp.norm.weight, mtp.layers.0.*).
   156	    """
   157	    from safetensors import safe_open
   158	
   159	    model_path = Path(model_path)
   160	    index_path = model_path / "model.safetensors.index.json"
   161	    if index_path.is_file():
   162	        with open(index_path) as f:
   163	            weight_map = json.load(f)["weight_map"]
   164	        file_to_keys: Dict[str, list] = {}
   165	        for key, filename in weight_map.items():
   166	            if key.startswith("mtp"):
   167	                file_to_keys.setdefault(filename, []).append(key)
   168	        files = file_to_keys
   169	    else:
   170	        # Single-file checkpoint: scan the one safetensors for mtp.* keys.
   171	        files = {"model.safetensors": None}
   172	
   173	    tensors: Dict[str, torch.Tensor] = {}
   174	    for filename, keys in files.items():
   175	        path = model_path / filename
   176	        if not path.is_file():
   177	            continue
   178	        with safe_open(str(path), framework="pt") as sf:
   179	            if keys is None:
   180	                keys = [k for k in sf.keys() if k.startswith("mtp")]
   181	            for key in keys:
   182	                tensors[key] = sf.get_tensor(key)
   183	    return tensors
