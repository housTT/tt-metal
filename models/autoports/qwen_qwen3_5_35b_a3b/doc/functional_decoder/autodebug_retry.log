   266	    return GDNWeights(
   267	        qkv_proj_weight=qkv_proj_weight,
   268	        q_proj_weight=q_proj_weight,
   269	        k_proj_weight=k_proj_weight,
   270	        v_proj_weight=v_proj_weight,
   271	        a_proj_weight=a_proj_weight,
   272	        b_proj_weight=b_proj_weight,
   273	        g_proj_weight=g_proj_weight,
   274	        o_proj_weight=o_proj_weight,
   275	        q_conv_weight=q_conv_weight,
   276	        k_conv_weight=k_conv_weight,
   277	        v_conv_weight=v_conv_weight,
   278	        q_conv_bias=q_conv_bias,
   279	        k_conv_bias=k_conv_bias,
   280	        v_conv_bias=v_conv_bias,
   281	        A_log=A_log,
   282	        dt_bias=dt_bias,
   283	        o_norm_weight=o_norm_weight,
   284	        A_neg=A_neg,
   285	        q_weight_taps=q_weight_taps,
   286	        k_weight_taps=k_weight_taps,
   287	        v_weight_taps=v_weight_taps,
   288	        q_bias_dev=q_bias_dev,
   289	        k_bias_dev=k_bias_dev,
   290	        v_bias_dev=v_bias_dev,
   291	        fused_conv_weight_taps=fused_conv_weight_taps,
   292	        fused_conv_bias_dev=fused_conv_bias_dev,
   293	        ab_proj_weight=ab_proj_weight,
   294	        mega_fused_weight=mega_fused_weight,
   295	        mega_qkv_dim=mega_qkv_dim,
   296	        mega_a_dim=mega_a_dim,
   297	        mega_b_dim=mega_b_dim,
   298	        mega_g_dim=mega_g_dim,
   299	        use_chunk_seq_prefill=use_chunk_seq_prefill,
   300	        chunk_seq_masks_long=chunk_seq_masks_long,
   301	    )

