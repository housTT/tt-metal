   329	    def is_moe_layer(self, layer_idx: int) -> bool:
   330	        """True when this layer uses the sparse MoE MLP instead of the dense SwiGLU.
   331	
   332	        Follows the HF Qwen3-Next / Qwen3.5-MoE rule: a layer is MoE when there
   333	        are experts, it is not forced dense (mlp_only_layers), and it falls on
   334	        the decoder_sparse_step cadence. On the dense 9B/27B num_experts==0 so
   335	        this is always False and the Qwen36MLP path is byte-for-byte unchanged.
   336	        """
   337	        if self.moe_num_experts <= 0:
   338	            return False
   339	        if layer_idx in self.mlp_only_layers:
   340	            return False
