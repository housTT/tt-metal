   123	        self.moe_top_k = getattr(text_config, "num_experts_per_tok", 0) or 0
   124	        self.moe_intermediate_size = getattr(text_config, "moe_intermediate_size", 0) or 0
   125	        self.moe_shared_intermediate_size = getattr(text_config, "shared_expert_intermediate_size", None)
   126	        self.moe_norm_topk_prob = bool(getattr(text_config, "norm_topk_prob", True))
   127	        self.moe_decoder_sparse_step = getattr(text_config, "decoder_sparse_step", 1) or 1
   128	        self.mlp_only_layers = set(getattr(text_config, "mlp_only_layers", None) or [])
