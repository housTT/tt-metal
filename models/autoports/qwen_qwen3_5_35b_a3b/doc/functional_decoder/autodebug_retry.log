    21	
    22	def apply_rotary_pos_emb_ttnn(q, k, cos, sin):
    23	    """Apply RoPE to query and key tensors using TTNN ops."""
    24	    if len(cos.shape) < 4:
    25	        cos = ttnn.unsqueeze(cos, 1)  # [B, 1, T, D]
    26	        sin = ttnn.unsqueeze(sin, 1)
    27	
    28	    rotary_dim = cos.shape[-1]
    29	    full_dim = q.shape[-1]
    30	
    31	    q_rot = q[..., :rotary_dim]
    32	    k_rot = k[..., :rotary_dim]
    33	
    34	    q_embed = ttnn.add(
    35	        ttnn.multiply(q_rot, cos),
    36	        ttnn.multiply(rotate_half_ttnn(q_rot), sin),
    37	    )
    38	    k_embed = ttnn.add(
    39	        ttnn.multiply(k_rot, cos),
    40	        ttnn.multiply(rotate_half_ttnn(k_rot), sin),
    41	    )
    42	
    43	    if rotary_dim < full_dim:
    44	        q_pass = q[..., rotary_dim:]
    45	        k_pass = k[..., rotary_dim:]
    46	        q_embed = ttnn.concat([q_embed, q_pass], dim=-1)
    47	        k_embed = ttnn.concat([k_embed, k_pass], dim=-1)
    48	
    49	    return q_embed, k_embed
