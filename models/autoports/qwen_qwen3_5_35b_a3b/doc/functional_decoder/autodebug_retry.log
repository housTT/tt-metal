    81	GatedDeltaAttnSeqDeviceOperation::spec_return_value_t GatedDeltaAttnSeqDeviceOperation::compute_output_specs(
    82	    const operation_attributes_t& attrs, [[maybe_unused]] const tensor_args_t& in) {
    83	    const uint32_t BH = attrs.num_heads;
    84	    const uint32_t NC = attrs.num_chunks;
    85	    const uint32_t C = attrs.chunk_size;
    86	    const uint32_t Dk = attrs.key_dim;
    87	    const uint32_t Dv = attrs.val_dim;
    88	    const auto& mc = attrs.output_mem_config;
    89	
    90	    tt::tt_metal::TensorSpec out_spec(
    91	        ttnn::Shape({BH, NC, C, Dv}), TensorLayout(DataType::FLOAT32, PageConfig(Layout::TILE), mc));
    92	    tt::tt_metal::TensorSpec state_spec(
    93	        ttnn::Shape({BH, Dk, Dv}), TensorLayout(DataType::FLOAT32, PageConfig(Layout::TILE), mc));
    94	    return {out_spec, state_spec};
    95	}
