    48	def _bmm_progcfg(device, mt, nt, kt):
    49	    """Batched-matmul program config: one full [mt,nt] output block per core, with the batch
    50	    spread across the whole device grid. TTNN's auto-config pins the recurrence's [128,128]@[128,128]
    51	    per-chunk bmms (kk, qk) to ~16 cores (one 4x4-tile output tiled across cores, batch looped
    52	    serially); here num_output_blocks = batch so the ~192 chunk-batch elements fan out over ~130
    53	    cores instead. Pure parallelization — matmul math is config-independent.
    54	
    55	    Returns None (-> TTNN auto-config, prior behaviour) when device is None or the shapes don't
    56	    tile cleanly.
    57	    """
    58	    if device is None or mt < 1 or nt < 1 or kt < 1:
    59	        return None
    60	    try:
    61	        grid = device.compute_with_storage_grid_size()
    62	        per_core_M, per_core_N = mt, nt
    63	        # out_subblock: largest h*w <= 4 tiles (fp32 DST limit) dividing per_core_M/N
    64	        osb_h, osb_w, best = 1, 1, 0
    65	        for h in range(1, per_core_M + 1):
    66	            if per_core_M % h:
    67	                continue
    68	            for w in range(1, per_core_N + 1):
    69	                if per_core_N % w:
    70	                    continue
    71	                if h * w <= 4 and h * w > best:
    72	                    best, osb_h, osb_w = h * w, h, w
    73	        # in0_block_w: largest divisor of kt, capped at 4 for L1 safety in fp32
    74	        in0_bw = 1
    75	        for c in (4, 3, 2, 1):
    76	            if c <= kt and kt % c == 0:
    77	                in0_bw = c
    78	                break
    79	        return ttnn.MatmulMultiCoreReuseProgramConfig(
    80	            compute_with_storage_grid_size=(grid.x, grid.y),
    81	            in0_block_w=in0_bw,
    82	            out_subblock_h=osb_h,
    83	            out_subblock_w=osb_w,
    84	            per_core_M=per_core_M,
    85	            per_core_N=per_core_N,
    86	        )
    87	    except Exception:
    88	        return None
