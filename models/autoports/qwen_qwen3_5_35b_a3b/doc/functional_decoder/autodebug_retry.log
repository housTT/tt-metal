    36	# Mask helpers shared with bf16 chunk path; import works via fq path or top-level `tt`.
    37	from .ttnn_delta_rule_ops import (
    38	    _create_triu_ones_ttnn as _create_triu_ones,
    39	    _create_tril_ones_ttnn as _create_tril_ones,
    40	    l2_norm_ttnn,
    41	)
