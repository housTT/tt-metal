   388	    def load_state_dict(self):
   389	        """Load + remap weights via the text-only HF Qwen3_5ForCausalLM.
   390	        Overrides base meta-key loader."""
   391	        from models.demos.blackhole.qwen36.tt.weight_mapping import (
   392	            is_fp8_checkpoint,
   393	            load_mtp_tensors,
   394	            load_qwen36_state_dict_fp8,
   395	            remap_qwen36_state_dict,
   396	        )
   397	
   398	        # Block FP8 checkpoints: dequant + remap for TP loaders (skip the HF model).
   399	        # The FP8 loader already keeps mtp.* (read raw from safetensors), so no extra merge.
   400	        if is_fp8_checkpoint(self.CKPT_DIR):
   401	            return load_qwen36_state_dict_fp8(self.CKPT_DIR)
   402	
   403	        # Import the HF classes directly rather than going through AutoModelForCausalLM.
   404	        # Serving out-of-tree, vllm.transformers_utils.config registers vLLM's OWN
   405	        # Qwen3_5Config for model_type "qwen3_5" into transformers' AutoConfig
   406	        # (AutoConfig.register(..., exist_ok=True)), so AutoConfig hands back vLLM's class.
   407	        # transformers only unwraps a composite config to its text sub-config when
   408	        # `model_class.config_class == config.sub_configs["text_config"]` — an identity
   409	        # check that cannot hold across libraries — so the composite config would reach
   410	        # Qwen3_5ForCausalLM and fail on `config.vocab_size` (which lives one level down,
   411	        # in text_config). Naming the classes here keeps config and model from the same
   412	        # library, matching vision/vision_model_config.py::reference_vision_model.
   413	        #
   414	        # Qwen3_5TextConfig.from_pretrained picks the `text_config` sub-dict on composite
   415	        # (3.6 VLM) checkpoints via base_config_key, and reads a text-only (3.5) config.json
   416	        # as-is, so both checkpoint layouts land on the config Qwen3_5ForCausalLM expects.
   417	        # The 35B-A3B is a Qwen3.5-MoE checkpoint (model_type qwen3_5_moe): its sparse experts and
   418	        # gated shared expert live under the MoE config that the dense Qwen3_5TextConfig silently
   419	        # drops — that class would build a dense mlp.gate_proj and leave mlp.shared_expert/experts
   420	        # unloaded. Pick the MoE text class for MoE configs; the dense/vision path keeps Qwen3_5.
   421	        if self.moe_num_experts > 0:
   422	            from transformers.models.qwen3_5_moe import Qwen3_5MoeForCausalLM as _HFForCausalLM
   423	            from transformers.models.qwen3_5_moe import Qwen3_5MoeTextConfig as _HFTextConfig
   424	        else:
   425	            from transformers.models.qwen3_5 import Qwen3_5ForCausalLM as _HFForCausalLM
   426	            from transformers.models.qwen3_5 import Qwen3_5TextConfig as _HFTextConfig
   427	
   428	        text_config = _HFTextConfig.from_pretrained(self.CKPT_DIR)
   429	        assert text_config.vocab_size == self.vocab_size and text_config.hidden_size == self.dim, (
   430	            f"HF text config disagrees with model args: vocab_size {text_config.vocab_size} vs "
   431	            f"{self.vocab_size}, hidden_size {text_config.hidden_size} vs {self.dim}"
   432	        )
   433	        model = _HFForCausalLM.from_pretrained(self.CKPT_DIR, config=text_config, dtype="auto")
   434	        state_dict = remap_qwen36_state_dict(model.state_dict())
   435	        del model
   436	        # AutoModelForCausalLM drops mtp.* before remap; read the drafter weights directly.
   437	        if getattr(self, "has_mtp", False):
   438	            state_dict.update(load_mtp_tensors(self.CKPT_DIR))
   439	        return state_dict

