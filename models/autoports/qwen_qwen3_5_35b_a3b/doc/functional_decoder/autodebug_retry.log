    52	def rms_norm_zero_centered_ttnn(x, weight, eps=1e-6):
    53	    """
    54	    Zero-centered RMSNorm using TTNN: x * rsqrt(mean(x^2) + eps) * (1 + weight).
    55	    """
    56	    x_sq = ttnn.multiply(x, x)
    57	    variance = ttnn.mean(x_sq, dim=-1, keepdim=True)
    58	    inv_rms = ttnn.rsqrt(ttnn.add(variance, eps))
    59	    x_normed = ttnn.multiply(x, inv_rms)
    60	    scale = ttnn.add(weight, 1.0)
    61	    return ttnn.multiply(x_normed, scale)
