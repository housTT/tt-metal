   162	    # Row-parallel down_proj partials -> reduce-scatter (fractured hidden), matching
   163	    # Qwen36MLP._forward_tp.
   164	    if num_devices > 1:
   165	        result_acc = tt_all_reduce(
   166	            result_acc,
   167	            mesh_device,
   168	            tt_ccl,
   169	            cluster_axis=0,
   170	            dim=3,
   171	            topology=topology,
   172	            memory_config=ttnn.DRAM_MEMORY_CONFIG,
   173	        )
