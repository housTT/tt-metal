    95	        down_input,
    96	        weights.down_proj,
    97	        sparsity=prefill_sparsity,
    98	        nnz=num_experts,
    99	        memory_config=ttnn.DRAM_MEMORY_CONFIG,
   100	        output_tile=output_tile,
   101	        program_config=down_config,
   102	        is_input_a_sparse=True,
   103	        dtype=ttnn.bfloat16,
   104	    )
