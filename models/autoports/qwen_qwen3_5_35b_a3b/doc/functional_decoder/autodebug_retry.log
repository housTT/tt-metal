   186	def load_qwen36_state_dict_fp8(model_path) -> Dict[str, torch.Tensor]:
   187	    """Load Qwen3.5 FP8 weights: block-wise dequant + minimal key remap.
   188	
   189	    Produces the SAME internal key scheme as ``remap_qwen36_state_dict`` for the
   190	    shared/simple weights (``layers.N.mlp.*``, ``layers.N.self_attn.*``,
   191	    ``input_layernorm`` / ``post_attention_layernorm``, ``tok_embeddings``,
   192	    ``norm``, ``output``) so ``layer.py``'s substate extraction is unchanged.
   193	
   194	    The one deliberate difference vs the single-device remap: GDN ``linear_attn.*``
   195	    projections are kept RAW (fused ``in_proj_qkv``, fused ``conv1d``, plus
   196	    ``in_proj_z`` / ``in_proj_a`` / ``in_proj_b`` / ``out_proj`` / ``A_log`` /
   197	    ``dt_bias`` / ``norm.weight``) — NOT split or renamed — so the tensor-parallel
   198	    GDN weight-prep helpers (prepare_gdn_qkv / prepare_conv_taps) can reorder and
   199	    shard them per device. The TP module loaders branch on this raw layout.
   200	    """
   201	    from safetensors import safe_open
   202	
   203	    from models.demos.blackhole.qwen36.tt.tp_common import dequant_fp8_block
   204	
   205	    model_path = Path(model_path)
   206	    index_path = model_path / "model.safetensors.index.json"
   207	    with open(index_path) as f:
   208	        weight_map = json.load(f)["weight_map"]
   209	
   210	    file_to_keys: Dict[str, list] = {}
   211	    for key, filename in weight_map.items():
   212	        file_to_keys.setdefault(filename, []).append(key)
   213	
   214	    raw: Dict[str, torch.Tensor] = {}
   215	    for filename, keys in file_to_keys.items():
   216	        with safe_open(str(model_path / filename), framework="pt") as sf:
   217	            present = set(sf.keys())
   218	            for key in keys:
   219	                if key in present:
   220	                    raw[key] = sf.get_tensor(key)
   221	
   222	    # Dequantize FP8 (skip the scale tensors themselves)
