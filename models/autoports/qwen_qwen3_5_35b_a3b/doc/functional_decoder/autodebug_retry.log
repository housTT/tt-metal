   158	    # ---- precompute helpers (bodies verbatim; self.device -> mesh_device, self.<dim> -> config.<dim>) ----
   159	
   160	    def _precompute_weight_taps(conv_weight):
   161	        """Pre-slice conv weight [D, 1, K] into K device tensors [1, 1, D] for FIR decode."""
   162	
   163	        weight_torch = ttnn.to_torch(conv_weight)
   164	        D = weight_torch.shape[0]
   165	        taps = []
   166	        for k in range(conv_kernel_size):
   167	            w_k = weight_torch[:, 0, k].reshape(1, 1, D).contiguous()
   168	            taps.append(ttnn.from_torch(w_k, dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=mesh_device))
   169	        return taps
   170	
   171	    def _precompute_bias_dev(conv_bias):
   172	        """Pre-convert conv bias to [1, 1, D] device tensor."""
   173	        if conv_bias is None:
   174	            return None
   175	
   176	        bias_torch = ttnn.to_torch(conv_bias)
   177	        D = bias_torch.numel()
   178	        bias_reshaped = bias_torch.reshape(1, 1, D).contiguous()
   179	        return ttnn.from_torch(bias_reshaped, dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=mesh_device)
   180	
   181	    def _precompute_fused_weight_taps():
   182	        """Pre-concatenate Q+K+V conv weight taps into fused taps [1, 1, D_total]."""
   183	        q_w = ttnn.to_torch(q_conv_weight)  # [D_q, 1, K]
   184	        k_w = ttnn.to_torch(k_conv_weight)  # [D_k, 1, K]
   185	        v_w = ttnn.to_torch(v_conv_weight)  # [D_v, 1, K]
   186	        # Concatenate along D dimension: [D_total, 1, K]
   187	        fused_w = torch.cat([q_w, k_w, v_w], dim=0)
   188	        D_total = fused_w.shape[0]
   189	        taps = []
   190	        for k_idx in range(conv_kernel_size):
   191	            w_k = fused_w[:, 0, k_idx].reshape(1, 1, D_total).contiguous()
   192	            taps.append(ttnn.from_torch(w_k, dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=mesh_device))
   193	        return taps
   194	
   195	    def _precompute_fused_bias_dev():
   196	        """Pre-concatenate Q+K+V conv biases into fused bias [1, 1, D_total]."""
   197	        parts = []
   198	        for bias in [q_conv_bias, k_conv_bias, v_conv_bias]:
   199	            if bias is not None:
   200	                parts.append(ttnn.to_torch(bias))
   201	            else:
   202	                return None  # If any is None, skip fused bias
   203	        fused = torch.cat(parts, dim=0)
   204	        D_total = fused.numel()
   205	        fused_reshaped = fused.reshape(1, 1, D_total).contiguous()
   206	        return ttnn.from_torch(fused_reshaped, dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=mesh_device)
   207	
   208	    def _precompute_fused_ab_weight():
   209	        """Pre-concatenate a_proj + b_proj weights into [4096, 64] for fused matmul."""
   210	        a_w = ttnn.to_torch(a_proj_weight)  # [4096, 32]
   211	        b_w = ttnn.to_torch(b_proj_weight)  # [4096, 32]
   212	        fused = torch.cat([a_w, b_w], dim=1).contiguous()  # [4096, 64]
   213	        return ttnn.from_torch(fused, dtype=ttnn.bfloat8_b, layout=ttnn.TILE_LAYOUT, device=mesh_device)
   214	
   215	    def _precompute_mega_fused_weight():
   216	        """Fuse QKV + a + b + g projections into one [4096, D_total] weight.
   217	
   218	        Saves 2 matmul kernel launches per decode step (QKV=1, ab=1, g=1 -> mega=1).
   219	        Output split: [qkv_dim | a_dim | b_dim | g_dim]
   220	        """
   221	        if qkv_proj_weight is None:
   222	            return None
   223	        qkv_w = ttnn.to_torch(qkv_proj_weight)  # [4096, 8192]
   224	        a_w = ttnn.to_torch(a_proj_weight)  # [4096, 32]
   225	        b_w = ttnn.to_torch(b_proj_weight)  # [4096, 32]
