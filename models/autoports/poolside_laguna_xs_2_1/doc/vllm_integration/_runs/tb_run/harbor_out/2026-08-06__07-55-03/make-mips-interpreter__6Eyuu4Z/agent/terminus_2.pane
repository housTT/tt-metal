    __asm__ volatile(
        /* Load syscall number into $v0 */
        "move $v0, %1\n\t"
        
        /* Load first four arguments into $a0-$a3 */
        "move $a0, %2\n\t"
        "move $a1, %3\n\t"
        "move $a2, %4\n\t"
        "move $a3, %5\n\t"
        
        /* Load additional arguments into $t0-$t1 */
        "move $t0, %6\n\t"  /* 5th arg in $t0 */
        "move $t1, %7\n\t"  /* 6th arg in $t1 */
        
        /* Make the syscall */
        "syscall\n\t"
        
        /* Get the return value */
        "move %0, $v0"
        
        /* Output parameter */
        : "=r" (result)
        
        /* Input parameters */
        : "r" (syscall_num),
          "r" (arg1),
          "r" (arg2),
          "r" (arg3),
          "r" (arg4),
          "r" (arg5),
          "r" (arg6)
        
