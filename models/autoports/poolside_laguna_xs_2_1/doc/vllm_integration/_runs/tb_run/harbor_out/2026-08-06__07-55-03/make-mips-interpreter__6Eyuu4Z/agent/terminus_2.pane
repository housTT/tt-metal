} DirEntry;

// File node structure
typedef struct FileNode {
    char name[MAX_PATH_LENGTH];
    int type;               // Regular file or directory
    time_t created;         // Creation time
    time_t modified;        // Last modification time
    time_t accessed;        // Last access time
    
    // File content
