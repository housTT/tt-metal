[1760.267038, "o", "        if (op === 0x32) { this.lo = Math.floor(this.reg[rs] / this.reg[rt]) >>> 0; this.hi = (this.reg[rs] % this.reg[rt]) >>> 0; return false; }\r\n\u001b[?2004l\r"]
[1760.267046, "o", "\u001b[?2004h> "]
