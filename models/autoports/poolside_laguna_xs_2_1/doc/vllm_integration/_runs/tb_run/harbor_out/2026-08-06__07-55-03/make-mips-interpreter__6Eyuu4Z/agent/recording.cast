[1760.267337, "o", "\u001b[?2004h"]
[1760.267346, "o", "> "]
[1760.267359, "o", "            this.pc = (this.pc + 4) >>> 0;\r\n\u001b[?2004l\r"]
[1760.267367, "o", "\u001b[?2004h> "]
[1760.267375, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
