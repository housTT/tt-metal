[1760.267127, "o", "        const d = fs.readFileSync(bp);\r\n\u001b[?2004l\r"]
[1760.267136, "o", "\u001b[?2004h"]
[1760.267143, "o", "> "]
[1760.267152, "o", "        d.copy(this.mem);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1760.267169, "o", "        this.pc = 0x400110;\r\n\u001b[?2004l\r"]
