[197.548043, "o", "\r\n// SYS_unlink: Delete a file\r\n// SYS_rename: Rename a file\r\n// SYS_mkdir: Create a directory\r\n        case SYS_read: {\r\n        case SYS_write: {\r\n        case SYS_open: {\r\n        case SYS_close: {\r\n        case SYS_lseek: {\r\n        case SYS_fsync: {\r\n        case SYS_rename: {\r\n"]
