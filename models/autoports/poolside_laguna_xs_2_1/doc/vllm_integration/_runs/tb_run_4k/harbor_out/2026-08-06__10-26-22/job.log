eSyscall(mem, regs) {\n  const num = regs.r[2];\n  const a0 = regs.r[4], a1 = regs.r[5], a2 = regs.r[6], a3 = regs.r[7];\n  \n  switch (num) {\n    case 10: console.log('exit'); process.exit(0);\n    case 4000:\n      console.log('save_frame');\n      saveBMP('frame.bmp', a1, a2, a3);\n      break;\n    case 4001:\n      console.log('set_buffer', '0x' + a0.toString(16));\n      break;\n  }\n}\n\n// MIPS CPU\nclass CPU {\n  constructor(binaryPath) {\n    this.mem = new Memory();\n    this.regs = new Regs();\n    this.binaryPath = binaryPath;\n  }\n  \n  load() {\n    const data = fs.readFileSync(this.binaryPath);\n    console.log('Loaded', data.length, 'bytes');\n    if (data[0] !== 0x7f || data[1] !== 0x45 || data[2] !== 0x4c || data[3] !== 0x46)\n      throw new Error('Not ELF');\n    const entry = data.readUInt32LE(24);\n    const phoff = data.readUInt32LE(28);\n    const phentSize = data.readUInt16LE(42);\n    const phnum = data.readUInt16LE(44);\n    console.log('Entry: 0x' + entry.toString(16));\n    let off = phoff;\n    for (let i = 0; i < phnum; i++) {\n      const type = data.readUInt32LE(off);\n      const vaddr = data.readUInt32LE(off + 8);\n      const foff = data.readUInt32LE(off + 12);\n      const fsize = data.readUInt32LE(off + 16);\n      if (type === 1) {\n        console.log('Loading to 0x' + vaddr.toString(16));\n        this.mem.data.set(data.slice(foff, foff + fsize), vaddr);\n      }\n      off += phentSize;\n    }\n    this.regs.pc = entry;\n  }\n  \n  step() {\n    const instr = this.mem.readU32(this.regs.pc);\n    if (instr === 0) return false;\n    const op = instr >>> 26;\n    const rs = (instr >>> 21) & 31;\n    const rt = (instr >>> 16) & 31;\n    const imm16 = instr & 0xffff;\n    \n    if (op === 0 && (instr & 0x3f) === 0x0c) {\n      handleSyscall(this.mem, this.regs);\n      this.regs.pc += 4;\n      return true;\n    }\n    \n    if (op === 2) {\n      this.regs.r[31] = this.regs.pc + 4;\n      this.regs.pc = (instr & 0x03ffffff) <