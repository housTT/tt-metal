// Syscall handler
function handleSyscall(mem, regs) {
  const num = regs.r[2];
  const a0 = regs.r[4], a1 = regs.r[5], a2 = regs.r[6], a3 = regs.r[7];
  
  switch (num) {
    case 10: console.log('exit'); process.exit(0);
    case 4000:
      console.log('save_frame');
      saveBMP('frame.bmp', a1, a2, a3);
      break;
    case 4001:
      console.log('set_buffer', '0x' + a0.toString(16));
      break;
  }
}

// MIPS CPU
class CPU {
  constructor(binaryPath) {
    this.mem = new Memory();
