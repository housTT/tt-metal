            lower_table[i] = i;
        }
        
        /* Set uppercase to lowercase */
        for (int i = 'A'; i <= 'Z'; i++) {
            lower_table[i] = i - 'A' + 'a';
        }
        
        initialized = 1;
    }
    
    static int* ptr = (int*)lower_table;
    return &ptr;
}

