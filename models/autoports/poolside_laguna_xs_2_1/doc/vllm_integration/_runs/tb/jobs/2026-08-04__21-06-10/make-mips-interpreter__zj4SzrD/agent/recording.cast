[1357.015623, "o", "9:#define SYS_read    0\r\n10:#define SYS_write   1\r\n11:#define SYS_open    2\r\n12:#define SYS_close   3\r\n13:#define SYS_lseek   8\r\n14:#define SYS_fsync   74\r\n15:#define SYS_rename  82\r\n16:#define SYS_mkdir   83\r\n17:#define SYS_unlink  87\r\n234:        int real_fd = real_syscall6(SYS_open, (long)wad_path, O_RDONLY, 0, 0, 0, 0);\r\n237:            off_t file_size = real_syscall6(SYS_lseek, real_fd, 0, SEEK_END, 0, 0, 0);\r\n238:            real_syscall6(SYS_lseek, real_fd, 0, SEEK_SET, 0, 0, 0); // Reset to beginning\r\n"]
[1357.015659, "o", "245:                    ssize_t bytes_read = real_syscall6(SYS_read, real_fd, (long)wad_data, file_size, 0, 0, 0);\r\n270:            real_syscall6(SYS_close, real_fd, 0, 0, 0, 0, 0);\r\n438:// SYS_read: Read from a file\r\n465:// SYS_write: Write to a file\r\n517:// SYS_open: Open a file\r\n594:// SYS_close: Close a file\r\n604:// SYS_lseek: Reposition read/write file offset\r\n635:// SYS_fsync: Synchronize a file's in-memory state (no-op for in-memory FS)\r\n646:// SYS_unlink: Delete a file\r\n704:// SYS_rename: Rename a file\r\n799:// SYS_mkdir: Create a directory\r\n850:        case SYS_read: {\r\n857:        case SYS_write: {\r\n864:        case SYS_open: {\r\n871:        case SYS_close: {\r\n876:        case SYS_lseek: {\r\n883:        case SYS_fsync: {\r\n888:        case SYS_rename: {\r\n"]
