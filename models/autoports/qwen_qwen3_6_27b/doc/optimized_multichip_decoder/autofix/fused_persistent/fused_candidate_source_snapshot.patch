+                out_subblock_w=1,
+                per_core_M=1,
+                per_core_N=per_core_n,
+                fuse_batch=True,
+                fused_activation=None,
+                mcast_in0=True,
+            ),
+            compute_kernel_config=compute_kernel_config,
+            chunks_per_sync=10,
+            num_workers_per_link=4,
+            num_buffers_per_channel=2,
