+        if hidden_states.memory_config() != ttnn.DRAM_MEMORY_CONFIG:
+            hidden_states = ttnn.to_memory_config(
+                hidden_states, ttnn.DRAM_MEMORY_CONFIG
+            )
+        intermediate, output = self.persistent_ccl_pool["fused_rs_buffers"][slot]
+        _, fractured = ttnn.experimental.matmul_reduce_scatter_async(
+            hidden_states,
