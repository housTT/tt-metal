+    def _fused_column_all_gather_matmul(
+        self, fractured, weight, *, slot, compute_kernel_config
+    ):
+        """Fuse the fractured-residual gather into its column consumer."""
+        self._ensure_fused_fractured_resources()
+        if fractured.memory_config() != ttnn.DRAM_MEMORY_CONFIG:
+            fractured = ttnn.to_memory_config(fractured, ttnn.DRAM_MEMORY_CONFIG)
+        if len(weight.shape) == 2:
+            weight = ttnn.reshape(weight, [1, 1, weight.shape[0], weight.shape[1]])
+        local_n = weight.shape[-1]
+        per_core_n = local_n // 32 // 8
+        gathered, output = ttnn.experimental.all_gather_matmul_async(
+            fractured,
+            weight,
+            persistent_output_buffer=None,
+            dim=3,
+            multi_device_global_semaphore=self.persistent_ccl_pool[
+                "fused_ag_semaphores"
+            ][slot],
+            all_gather_core_grid_offset=(0, 4),
+            barrier_semaphore=self.persistent_ccl_pool["fused_ag_barriers"][slot],
+            num_links=2,
+            # Keep the gathered lhs interleaved in DRAM.  The exact 4-core L1
+            # form overlaps the fused matmul's static circular-buffer region
+            # at this decoder's 5,120-wide K; the consumer below can reshard
+            # the returned lhs only when the second shared-lhs matmul needs it.
+            memory_config_ag=ttnn.DRAM_MEMORY_CONFIG,
+            topology=ttnn.Topology.Ring,
+            subdevice_id=self.persistent_ccl_worker_id,
