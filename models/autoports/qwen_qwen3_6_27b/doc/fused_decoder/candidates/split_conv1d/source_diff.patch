+    def _linear_split_conv1d(self, tensor, *, input_length: int):
+        """Run the Qwen causal depthwise convolution as four BF16 conv1d ops."""
+        self._record_fusion("split_depthwise_conv1d")
+        tensor = ttnn.to_layout(tensor, ttnn.ROW_MAJOR_LAYOUT)
+        geometry = (tensor.shape[0], input_length)
+        prepare = geometry not in self.linear_conv1d_prepared_weights
+        weights = (
+            self.linear_conv1d_host_weights
+            if prepare
+            else self.linear_conv1d_prepared_weights[geometry]
+        )
+        outputs = []
+        prepared_weights = []
+        split_width = 2560
+        for index, start in enumerate(range(0, self.conv_dim, split_width)):
+            split = ttnn.slice(
+                tensor,
+                [0, 0, 0, start],
+                [tensor.shape[0], 1, input_length, start + split_width],
+            )
+            result = ttnn.conv1d(
+                input_tensor=split,
+                weight_tensor=weights[index],
+                in_channels=split_width,
+                out_channels=split_width,
+                device=self.mesh_device,
+                kernel_size=self.conv_kernel_size,
+                stride=1,
+                padding=0,
+                batch_size=tensor.shape[0],
+                input_length=input_length,
+                conv_config=self.linear_conv1d_config,
+                compute_config=self.linear_conv1d_compute_config,
+                groups=split_width,
+                dtype=ttnn.bfloat16,
+                memory_config=ttnn.DRAM_MEMORY_CONFIG,
+                return_output_dim=True,
+                return_weights_and_bias=prepare,
+            )
+            if prepare:
+                output, out_length, (prepared_weight, _) = result
+                prepared_weights.append(prepared_weight)
+            else:
+                output, out_length = result
+            if out_length != input_length - self.conv_kernel_size + 1:
+                raise RuntimeError(f"unexpected conv1d output length {out_length}")
+            outputs.append(output)
+        if prepare:
+            self.linear_conv1d_prepared_weights[geometry] = prepared_weights
+        return ttnn.concat(outputs, dim=3, memory_config=ttnn.DRAM_MEMORY_CONFIG)
+
